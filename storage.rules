rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)); }
    // Storage uses the same explicit account activation requirement as
    // Firestore, Functions, and the sign-in blocking function.
    function profileIsActive() { return profile().active == true; }
    function canReadDocuments() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.documents in ['view', 'edit']); }
    function canEditDocuments() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.documents == 'edit'); }
    function canReadDamageDocuments() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.damages in ['view', 'edit']); }
    function canEditDamageDocuments() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.damages == 'edit'); }
    function canReadLegalDisputeDocuments() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.legalDisputes in ['view', 'edit']); }
    function canEditLegalDisputeDocuments() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.legalDisputes == 'edit'); }
    function canReadInkassoDocuments() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.inkasso in ['view', 'edit']); }
    function canEditInkassoDocuments() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.inkasso == 'edit'); }
    function canReadInsolvencyDocuments() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.insolvencies in ['view', 'edit']); }
    function canEditInsolvencyDocuments() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.insolvencies == 'edit'); }
    function contractRead() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.contracts in ['view', 'edit']); }
    function contractEdit() { return hasProfile() && profileIsActive() && (profile().role == 'superadmin' || profile().permissions.contracts == 'edit'); }
    function contractExists(contractId) { return firestore.exists(/databases/(default)/documents/contracts/$(contractId)); }
    function contractDocument(contractId, fileName) { return firestore.get(/databases/(default)/documents/contracts/$(contractId)/documents/$(fileName.replace('\\.pdf$', ''))).data; }
    function insolvencyExists(partnerId) { return firestore.exists(/databases/(default)/documents/insolvencies/$(partnerId)); }
    function isPdfUpload(fileName) {
      return request.resource.contentType == 'application/pdf'
        && fileName.matches('.*\\.pdf')
        && request.resource.size <= 20 * 1024 * 1024;
    }
    // Signatures deliberately have no administrative access path. The UID in
    // the object path must always be the UID from the authenticated token.
    function ownsSignature(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && hasProfile()
        && profileIsActive();
    }
    function isJpegSignature() {
      return request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024;
    }

    match /internalDocuments/{documentId}/{fileName} {
      allow read: if canReadDocuments();
      allow create, update: if canEditDocuments() && isPdfUpload(fileName);
      allow delete: if canEditDocuments();
    }

    match /contracts/{contractId}/documents/{fileName} {
      allow read: if contractRead() && contractExists(contractId)
        && contractDocument(contractId, fileName).status == 'ready'
        && contractDocument(contractId, fileName).storagePath == 'contracts/' + contractId + '/documents/' + fileName;
      allow create: if resource == null && contractEdit() && contractExists(contractId)
        && fileName.matches('^[A-Za-z0-9_-]+\\.pdf$') && isPdfUpload(fileName) && request.resource.size > 0
        && contractDocument(contractId, fileName).status == 'pending'
        && contractDocument(contractId, fileName).fileSize == request.resource.size
        && request.resource.metadata.contractId == contractId
        && request.resource.metadata.documentId + '.pdf' == fileName;
      allow update: if false;
      allow delete: if contractEdit() && contractExists(contractId)
        && contractDocument(contractId, fileName).status == 'pending';
    }

    match /damage-cases/{caseId}/documents/{fileName} {
      allow read: if canReadDamageDocuments();
      allow create: if canEditDamageDocuments() && isPdfUpload(fileName) && fileName.matches('^[A-Za-z0-9_-]+\\.pdf$');
      allow update: if false;
      allow delete: if canEditDamageDocuments();
    }

    match /legal-disputes/{caseId}/documents/{fileName} {
      allow read: if canReadLegalDisputeDocuments();
      allow create: if canEditLegalDisputeDocuments() && isPdfUpload(fileName) && fileName.matches('^[A-Za-z0-9_-]+\\.pdf$');
      allow update: if false;
      allow delete: if canEditLegalDisputeDocuments();
    }

    match /inkasso-cases/{caseId}/documents/{fileName} {
      allow read: if canReadInkassoDocuments();
      allow create: if canEditInkassoDocuments() && isPdfUpload(fileName) && fileName.matches('^[A-Za-z0-9_-]+\\.pdf$');
      allow update: if false;
      allow delete: if canEditInkassoDocuments();
    }

    match /insolvencies/{partnerId}/documents/{fileName} {
      allow read: if canReadInsolvencyDocuments();
      allow create: if canEditInsolvencyDocuments() && insolvencyExists(partnerId) && isPdfUpload(fileName) && fileName.matches('^[A-Za-z0-9_-]+\\.pdf$');
      allow update: if false;
      allow delete: if canEditInsolvencyDocuments();
    }

    // A single, fixed object name prevents user-controlled paths and listing.
    // No other match grants access below user-signatures.
    match /user-signatures/{uid}/signature.jpg {
      allow read: if ownsSignature(uid);
      allow create, update: if ownsSignature(uid) && isJpegSignature();
      allow delete: if ownsSignature(uid);
    }


  }
}
