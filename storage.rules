rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function documentsLevel() { return profile().role == 'superadmin' ? 'edit' : profile().permissions.documents; }
    match /internalDocuments/{allPaths=**} {
      allow read: if request.auth != null && documentsLevel() in ['view', 'edit'];
      allow write: if request.auth != null && documentsLevel() == 'edit';
    }
  }
}
