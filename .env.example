# Public reCAPTCHA Enterprise site key for Firebase App Check. This is not a secret.
# Register the production Web app in Firebase Console before setting the value.
VITE_APP_CHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development automatically asks Firebase to generate a browser-specific
# App Check debug token. Do not put that token in this file or any VITE_ variable.
# Allowlist it manually in Firebase Console > App Check > Apps > Manage debug tokens.
