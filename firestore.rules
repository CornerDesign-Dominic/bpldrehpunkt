      return type == 'people' ? data.audienceId == null
          && data.audienceIds is list && data.audienceIds.size() > 0 && data.audienceIds.size() <= 50
          && label is string && label.size() > 0 && label.size() <= 4000
        : type == 'all' ? data.audienceId == null && noAudienceIds(data) && label == 'Alle'
        : type == 'department' ? data.audienceId is string && data.audienceId.size() > 0 && noAudienceIds(data)
          && (label == data.audienceId || label == 'Abteilung: ' + data.audienceId)
        : type == 'person' && data.audienceId is string && noAudienceIds(data) && validTodoPersonAudience(data);
    }
    function validTodoExtras(data, previous, profile) {
