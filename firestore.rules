          data.withdrawnAt, data.withdrawnByUserId].hasOnly([null]);
    }
    function isCreatedTodo() {
      let data = request.resource.data;
      let profile = ownProfile();
      return profile.active == true && (profile.role == 'superadmin' || profile.permissions.get('todos', 'none') == 'edit')
        && todoKeysAreValid(data) && validTodoContent(data, {}, profile) && validNewTodoReminderSchedule(data)
        && data.creatorUserId == request.auth.uid && todoProfileNameMatches(data.creatorName, profile)
        && hasOpenAssignment(data) && validTodoReminderRecipients(data) && [data.createdAt, data.updatedAt].hasOnly([request.time]);
    }
    function isTodoCollaborator(data) {
      // All callers first require an active todos editor. Legacy assignment
      // snapshots never grant collaboration or visibility.
      return data.creatorUserId == request.auth.uid || ownProfile().role == 'superadmin' || isTodoAudienceMember(data);
    }
    function validTodoReminderRecipients(data) {
      let mode = data.get('reminderRecipientMode', 'all');
      let ids = data.get('reminderRecipientUserIds', []);
      return mode == 'selected' ? ids is list && ids.size() <= 50
        : mode == 'all' && ids == [];
    }
    function isCompletion() {
      let data = request.resource.data;
      return resource.data.status in ['open', 'in_progress'] && isTodoCollaborator(resource.data)
        && data.status == 'completed' && data.completedAt == request.time && data.completedByUserId == request.auth.uid
        && todoProfileNameMatches(data.completedByName, ownProfile()) && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedByUserId', 'completedByName', 'updatedAt']);
    }
    function isReactivation() {
      let data = request.resource.data;
      return resource.data.status == 'completed' && isTodoCollaborator(resource.data)
        && data.status == 'open' && [data.completedAt, data.completedByUserId, data.completedByName].hasOnly([null])
        && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedByUserId', 'completedByName', 'updatedAt']);
    }
    function isCreatorContentEdit() {
      let data = request.resource.data;
      return resource.data.status in ['open', 'in_progress'] && isTodoCollaborator(resource.data)
        && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'dueDate', 'reminderDate', 'reminderTime', 'reminderOccurrence', 'reminderRecipientMode', 'reminderRecipientUserIds', 'priority', 'customerId', 'customerName', 'carrierId', 'carrierName', 'reference', 'transportOrderId', 'transportOrderNumber', 'transportOrderLinks', 'damageCaseId', 'insolvencyId', 'legalDisputeId', 'inkassoCaseId', 'updatedAt'])
        && validTodoContent(data, resource.data, ownProfile()) && validChangedTodoReminderSchedule(resource.data, data)
        && validTodoReminderRecipients(data);
    }
    function isCreatorResetAssignment() {
      let data = request.resource.data;
      return resource.data.status in ['open', 'in_progress'] && isCreatorOrSuperadmin()
        && hasOpenAssignment(data) && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'dueDate', 'reminderDate', 'reminderTime', 'reminderOccurrence', 'reminderRecipientMode', 'reminderRecipientUserIds', 'priority', 'customerId', 'customerName', 'carrierId', 'carrierName', 'reference', 'transportOrderId', 'transportOrderNumber', 'transportOrderLinks', 'damageCaseId', 'insolvencyId', 'legalDisputeId', 'inkassoCaseId', 'audienceType', 'audienceId', 'audienceIds', 'audienceLabel', 'assignedUserId', 'assignedUserName', 'assignedAt', 'status', 'updatedAt'])
        && validTodoContent(data, resource.data, ownProfile()) && validChangedTodoReminderSchedule(resource.data, data)
        && validTodoReminderRecipients(data);
    }
    function isWithdrawal() {
