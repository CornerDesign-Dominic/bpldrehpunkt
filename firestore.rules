        && origin.get('partnerId', null) == partnerId
        && (data.counterparty == currentName
          || (data.counterparty is string && data.counterparty.size() > 0
            && (data.counterparty == origin.get(partnerRole == 'customer' ? 'name' : 'originalName', null)
              || data.counterparty == origin.get('partnerName', null))))
        && existsAfter(/databases/$(database)/documents/caseTransportOrderLinks/$(linkId));
    }
    function legalDisputeCounterpartyMatches(data, partnerId, partnerRole) {
      let partner = get(/databases/$(database)/documents/businessPartners/$(partnerId)).data;
      let orderId = data.get('counterpartySourceTransportOrderId', null);
      return orderId == null
        ? legalDisputePartnerHasRole(partner, partnerRole) && data.counterparty == partner.companyName
          && partner.get('mergedIntoPartnerId', null) == null && partner.get('status', '') != 'merged'
        : orderId is string
          && (legalDisputeRoleValue(partner.get('businessPartnerRoles', []), partnerRole)
            || (partnerRole == 'carrier' && 'taImportStatus' in partner && hasProvisionalTransportCarrierRole(partner))
            || legalDisputePartnerHasRole(partner, partnerRole))
          && legalDisputePartnerOriginMatches(data, partnerId, partnerRole, orderId, partner.companyName);
    }
    function validLegalDisputeCounterparty(data) {
      let partnerId = data.get('counterpartyPartnerId', null);
      let partnerRole = data.get('counterpartyPartnerRole', null);
      return (partnerId == null && partnerRole == null && data.get('counterpartySourceTransportOrderId', null) == null)
        || (partnerId is string && partnerId.size() > 0 && partnerId.size() <= 240 && !partnerId.matches('.*[/].*')
          && partnerRole in ['customer', 'carrier']
          && legalDisputeCounterpartyMatches(data, partnerId, partnerRole));
    }
    function todoAccess(requiredLevel) {
      let profile = ownProfile();
      // Equivalent to view/edit('todos'), without repeatedly expanding the
      // active-profile and superadmin gates for the same creation/history.
      return signedIn() && profile.active == true
        && (profile.role == 'superadmin' || (requiredLevel == 'edit'
          ? profile.permissions.get('todos', 'none') == 'edit'
          : profile.permissions.get('todos', 'none') in ['view', 'edit']));
    }
    function validTodoPersonAudience(data) {
      // To-do content is validated only after an active editor gate. The
      // current user's profile therefore need not be looked up a second time.
      return data.audienceId == request.auth.uid ? data.audienceLabel == profileName(ownProfile())
        : activeProfile(data.audienceId) && data.audienceLabel == profileName(get(/databases/$(database)/documents/users/$(data.audienceId)).data);
    }
    function todoOriginModuleVisible(profile, module) {
      return profile.role == 'superadmin' || profile.get('permissions', {}).get(module, 'none') in ['view', 'edit'];
    }
    function todoOriginId(value) {
      return value is string && value.size() > 0 && value.size() <= 240 && !value.matches('.*[/].*');
    }
    function todoSourceSlotsMatch(source, data, needs, customerIdKey, customerNameKey, carrierIdKey, carrierNameKey) {
      return (!needs.customer || (source.get(customerIdKey, null) == data.customerId && source.get(customerNameKey, null) == data.customerName))
        && (!needs.carrier || (source.get(carrierIdKey, null) == data.carrierId && source.get(carrierNameKey, null) == data.carrierName));
    }
    function todoDamageOriginNamesMatch(data, needs) {
      let source = get(/databases/$(database)/documents/damageCases/$(data.damageCaseId)).data;
      return todoSourceSlotsMatch(source, data, needs, 'claimantPartnerId', 'claimant', 'contractorPartnerId', 'contractor');
    }
    function todoInkassoOriginNamesMatch(data, needs) {
      let source = get(/databases/$(database)/documents/inkassoCases/$(data.inkassoCaseId)).data;
      let customer = source.get('debtorPartnerRole', null) == 'customer';
      return (customer ? !needs.carrier : !needs.customer)
        && todoSourceSlotsMatch(source, data, needs, 'debtorPartnerId', 'debtorName', 'debtorPartnerId', 'debtorName');
    }
    function todoInsolvencyOriginNamesMatch(data, needs) {
      let source = get(/databases/$(database)/documents/insolvencies/$(data.insolvencyId)).data;
      return source.get('mergedIntoPartnerId', null) == null && source.get('splitArchivedAt', null) == null
        && todoSourceSlotsMatch(source, data, needs, 'partnerId', 'partnerName', 'partnerId', 'partnerName');
    }
    function todoLegalOriginNamesMatch(data, needs) {
      let source = get(/databases/$(database)/documents/legalDisputes/$(data.legalDisputeId)).data;
      let role = source.get('counterpartyPartnerRole', null);
      return role in ['customer', 'carrier'] && (role == 'customer' ? !needs.carrier : !needs.customer)
        && todoSourceSlotsMatch(source, data, needs, 'counterpartyPartnerId', 'counterparty', 'counterpartyPartnerId', 'counterparty');
    }
    function todoTransportOrderOriginNamesMatch(orderId, data, needs) {
      let imported = get(/databases/$(database)/documents/transportOrders/$(orderId)).data.get('imported', {});
      let customer = imported.get('customer', {});
      let carrier = imported.get('carrier', {});
      return (!needs.customer || (customer.get('partnerId', null) == data.customerId
          && (customer.get('name', null) == data.customerName ? true : customer.get('partnerName', null) == data.customerName)))
        && (!needs.carrier || (carrier.get('partnerId', null) == data.carrierId
          && (carrier.get('originalName', null) == data.carrierName ? true : carrier.get('partnerName', null) == data.carrierName)));
    }
    function todoFirstOrderOriginNamesMatch(data, needs, profile) {
      let links = data.get('transportOrderLinks', []);
      let orderId = links is list && links.size() > 0 && links[0] is map ? links[0].get('id', null) : null;
      return todoOriginId(orderId) && todoOriginModuleVisible(profile, 'transportOrders')
        // A missing optional TA must leave the independent case-origin proof usable.
        && exists(/databases/$(database)/documents/transportOrders/$(orderId))
        && todoTransportOrderOriginNamesMatch(orderId, data, needs);
    }
    function todoOriginNamesMatch(data, needs, profile) {
      // A follow-up has one origin. All inherited historical slots must be
      // proven together by the same readable case, or the first linked TA.
      return todoFirstOrderOriginNamesMatch(data, needs, profile) ? true
        : (todoOriginId(data.get('damageCaseId', null)) && todoOriginModuleVisible(profile, 'damages') && todoDamageOriginNamesMatch(data, needs))
        || (todoOriginId(data.get('inkassoCaseId', null)) && todoOriginModuleVisible(profile, 'inkasso') && todoInkassoOriginNamesMatch(data, needs))
        || (todoOriginId(data.get('insolvencyId', null)) && todoOriginModuleVisible(profile, 'insolvencies') && todoInsolvencyOriginNamesMatch(data, needs))
        || (todoOriginId(data.get('legalDisputeId', null)) && todoOriginModuleVisible(profile, 'legalDisputes') && todoLegalOriginNamesMatch(data, needs));
    }
    function todoPartnerHasRole(partner, role) {
      let number = partner.get(role == 'customer' ? 'debtorNumber' : 'creditorNumber', '');
      return number is string && number.size() > 0 ? true
        : ('businessPartnerRoles' in partner && legalDisputeRoleValue(partner.businessPartnerRoles, role)) ? true
        : ('partnerRoles' in partner && legalDisputeRoleValue(partner.partnerRoles, role)) ? true
        : (role == 'carrier' && 'taImportStatus' in partner && hasProvisionalTransportCarrierRole(partner)) ? true
        : legalDisputePartnerHasRole(partner, role);
    }
    function validNewTodoPartnerLinks(data, profile) {
      let customerId = data.get('customerId', null);
      let carrierId = data.get('carrierId', null);
      let customerName = data.get('customerName', null);
      let carrierName = data.get('carrierName', null);
      let customer = customerId is string ? get(/databases/$(database)/documents/businessPartners/$(customerId)).data : {};
      let carrier = carrierId is string ? get(/databases/$(database)/documents/businessPartners/$(carrierId)).data : {};
      let needs = {
        'customer': customerId is string && customerName != customer.get('companyName', null),
        'carrier': carrierId is string && carrierName != carrier.get('companyName', null)
      };
      return ((customerId == null && customerName == null && (('customerId' in data) == ('customerName' in data))) || (customerId is string && customerName is string && todoPartnerHasRole(customer, 'customer')))
        && ((carrierId == null && carrierName == null && (('carrierId' in data) == ('carrierName' in data))) || (carrierId is string && carrierName is string && todoPartnerHasRole(carrier, 'carrier')))
        && (!(needs.customer || needs.carrier) || todoOriginNamesMatch(data, needs, profile));
    }
    function validTodoPartnerLinks(data, previous, profile) {
      let customerId = data.get('customerId', null);
      let carrierId = data.get('carrierId', null);
      let customerChanged = !unchangedPartnerBinding(data, previous, ['customerId', 'customerName']);
      let carrierChanged = !unchangedPartnerBinding(data, previous, ['carrierId', 'carrierName']);
      let customer = customerChanged && customerId is string ? get(/databases/$(database)/documents/businessPartners/$(customerId)).data : {};
      let carrier = carrierChanged && carrierId is string ? get(/databases/$(database)/documents/businessPartners/$(carrierId)).data : {};
      let needs = {
        'customer': customerChanged && customerId is string && data.get('customerName', null) is string && data.customerName != customer.get('companyName', null),
        'carrier': carrierChanged && carrierId is string && data.get('carrierName', null) is string && data.carrierName != carrier.get('companyName', null)
      };
      return (!customerChanged || validCustomerLink(data, customer)) && (!carrierChanged || validCarrierLink(data, carrier))
        && (!(needs.customer || needs.carrier) || todoOriginNamesMatch(data, needs, profile));
    }
    function todoKeysAreValid(data) {
      let required = ['title', 'description', 'dueDate', 'creatorUserId', 'creatorName', 'audienceType', 'audienceId', 'audienceLabel', 'assignedUserId', 'assignedUserName', 'assignedAt', 'status', 'completedAt', 'completedByUserId', 'completedByName', 'withdrawnAt', 'withdrawnByUserId', 'createdAt', 'updatedAt'];
      let keys = data.keys();
      return keys.hasAll(required)
        && keys.hasOnly(required.concat(['reminderDate', 'reminderTime', 'reminderOccurrence', 'reminderRecipientMode', 'reminderRecipientUserIds', 'priority', 'customerId', 'customerName', 'carrierId', 'carrierName', 'reference', 'transportOrderId', 'transportOrderNumber', 'transportOrderLinks', 'damageCaseId', 'insolvencyId', 'legalDisputeId', 'inkassoCaseId', 'audienceIds']));
    }
    function profileName(profile) {
      let first = profile.get('firstName', '');
      let last = profile.get('lastName', '');
      let name = ((first is string ? first : '') + ' ' + (last is string ? last : '')).trim();
      return name.size() > 0 ? name
        : (profile.get('name', '') is string && profile.get('name', '').size() > 0 ? profile.name
          : (profile.get('email', '') is string && profile.get('email', '').size() > 0 ? profile.email : 'Benutzer'));
    }
    function todoProfileNameMatches(value, profile) {
      // Normal two-part profiles avoid expanding legacy fallback validation in
