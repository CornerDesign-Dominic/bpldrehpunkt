      let reference = data.get('reference', null);
      return data.get('priority', 'medium') in ['low', 'medium', 'high']
        && (previous.size() == 0 || reminder == null || (reminder is string && reminder.size() == 10))
        && (previous.size() == 0 ? validNewTodoPartnerLinks(data, profile) : validTodoPartnerLinks(data, previous, profile))
        && validTransportOrderLink(data) && validTransportOrderLinks(data)
        && ((data.get('damageCaseId', null) == null && data.get('insolvencyId', null) == null && data.get('legalDisputeId', null) == null && data.get('inkassoCaseId', null) == null)
          || (validDamageCaseLink(data) && validInsolvencyLink(data) && validLegalDisputeLink(data) && validInkassoCaseLink(data)))
        && (reference == null || (reference is string && reference.size() <= 240));
    }
    function validCustomerLink(data, partner) {
      return !data.keys().hasAny(['customerId', 'customerName']) || (data.customerId == null && data.customerName == null)
        || (data.customerId is string && data.customerName is string && todoPartnerHasRole(partner, 'customer'));
    }
    function validCarrierLink(data, partner) {
      return !data.keys().hasAny(['carrierId', 'carrierName']) || (data.carrierId == null && data.carrierName == null)
        || (data.carrierId is string && data.carrierName is string && todoPartnerHasRole(partner, 'carrier'));
    }
    function validTransportOrderLink(data) {
      return (data.get('transportOrderId', null) == null && data.get('transportOrderNumber', null) == null)
        || (data.transportOrderId is string && data.transportOrderNumber is string
          && exists(/databases/$(database)/documents/transportOrders/$(data.transportOrderId))
          && data.transportOrderNumber == get(/databases/$(database)/documents/transportOrders/$(data.transportOrderId)).data.externalNumber);
    }
    function validTransportOrderLinks(data) {
      let links = data.get('transportOrderLinks', null);
      return links == null || (links is list && links.size() <= 20);
    }
    function validDamageCaseLink(data) {
      let id = data.get('damageCaseId', null);
      return id == null || (id is string && exists(/databases/$(database)/documents/damageCases/$(id)));
    }
    function validInsolvencyLink(data) {
      let id = data.get('insolvencyId', null);
      return id == null || (id is string && exists(/databases/$(database)/documents/insolvencies/$(id)));
    }
    function validLegalDisputeLink(data) {
      let id = data.get('legalDisputeId', null);
      return id == null || (id is string && exists(/databases/$(database)/documents/legalDisputes/$(id)));
    }
    function validInkassoCaseLink(data) {
      let id = data.get('inkassoCaseId', null);
      return id == null || (id is string && exists(/databases/$(database)/documents/inkassoCases/$(id)));
    }
    function validTodoContent(data, previous, profile) {
      let title = data.title;
      let description = data.description;
      let dueDate = data.dueDate;
      return title is string && title.size() > 0 && title.size() <= 240
        && description is string && description.size() <= 4000
        && (dueDate == null || dueDate is string)
        && (previous.size() == 0
          ? ((data.audienceType == 'person' && data.audienceId == request.auth.uid)
            ? noAudienceIds(data) && data.audienceLabel == data.creatorName : validTodoAudience(data))
          : (!data.diff(previous).affectedKeys().hasAny(['audienceType', 'audienceId', 'audienceIds', 'audienceLabel']) || validTodoAudience(data)))
        && validTodoExtras(data, previous, profile);
    }
    function isTodoAudienceMember(data) {
      return data.audienceType == 'all'
        || (data.audienceType == 'person' && data.audienceId == request.auth.uid)
        || (data.audienceType == 'people' && request.auth.uid in data.audienceIds)
        || (data.audienceType == 'department' && data.audienceId == ownProfile().department.trim());
    }
    function canReadTodo(data) {
      return data.creatorUserId == request.auth.uid
