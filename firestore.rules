        || (data.audienceType == 'people' && data.audienceId == null && data.keys().hasAll(['audienceIds'])
          && data.audienceIds is list && data.audienceIds.size() > 0 && data.audienceIds.size() <= 50
          && data.audienceLabel is string && data.audienceLabel.size() > 0 && data.audienceLabel.size() <= 4000);
    }
    function validTodoExtras(data) {
      return (!data.keys().hasAny(['priority']) || data.priority in ['low', 'medium', 'high'])
        && (!data.keys().hasAny(['reminderDate']) || data.reminderDate == null || (data.reminderDate is string && data.reminderDate.size() == 10))
        && validCustomerLink(data) && validCarrierLink(data) && validDamageCaseLink(data)
        && (!data.keys().hasAny(['reference']) || data.reference == null || (data.reference is string && data.reference.size() <= 240));
    }
    function validCustomerLink(data) {
      return !data.keys().hasAny(['customerId', 'customerName']) || (data.customerId == null && data.customerName == null)
        || (data.customerId is string && data.customerName is string
          && exists(/databases/$(database)/documents/businessPartners/$(data.customerId))
          && get(/databases/$(database)/documents/businessPartners/$(data.customerId)).data.debtorNumber is string
          && get(/databases/$(database)/documents/businessPartners/$(data.customerId)).data.debtorNumber.size() > 0
          && data.customerName == get(/databases/$(database)/documents/businessPartners/$(data.customerId)).data.companyName);
    }
    function validCarrierLink(data) {
      return !data.keys().hasAny(['carrierId', 'carrierName']) || (data.carrierId == null && data.carrierName == null)
        || (data.carrierId is string && data.carrierName is string
          && exists(/databases/$(database)/documents/businessPartners/$(data.carrierId))
          && get(/databases/$(database)/documents/businessPartners/$(data.carrierId)).data.creditorNumber is string
          && get(/databases/$(database)/documents/businessPartners/$(data.carrierId)).data.creditorNumber.size() > 0
          && data.carrierName == get(/databases/$(database)/documents/businessPartners/$(data.carrierId)).data.companyName);
    }
    function validDamageCaseLink(data) {
      return !data.keys().hasAny(['damageCaseId']) || data.damageCaseId == null
        || (data.damageCaseId is string && exists(/databases/$(database)/documents/damageCases/$(data.damageCaseId)));
    }
    function validTodoContent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 240
        && data.description is string && data.description.size() <= 4000
        && (data.dueDate == null || data.dueDate is string)
        && validTodoAudience(data) && validTodoExtras(data);
    }
    function isTodoAudienceMember(data) {
      return data.audienceType == 'all'
        || (data.audienceType == 'person' && data.audienceId == request.auth.uid)
        || (data.audienceType == 'people' && request.auth.uid in data.audienceIds)
        || (data.audienceType == 'department' && data.audienceId == ownProfile().department);
    }
    function canReadTodo(data) {
      return superadmin() || data.creatorUserId == request.auth.uid || data.assignedUserId == request.auth.uid
        || (data.status != 'withdrawn' && isTodoAudienceMember(data));
    }
    function isCreatorOrSuperadmin() { return superadmin() || resource.data.creatorUserId == request.auth.uid; }
    function hasOpenAssignment(data) {
      return data.status == 'open' && data.assignedUserId == null && data.assignedUserName == null && data.assignedAt == null
        && data.completedAt == null && data.completedByUserId == null && data.completedByName == null
        && data.withdrawnAt == null && data.withdrawnByUserId == null;
    }
    function isCreatedOpenTodo() {
      return hasOpenAssignment(request.resource.data);
    }
    function isCreatedOwnTodo() {
      return request.resource.data.audienceType == 'person' && request.resource.data.audienceId == request.auth.uid
        && request.resource.data.audienceLabel == profileName(ownProfile())
        && request.resource.data.status == 'in_progress' && request.resource.data.assignedUserId == request.auth.uid
        && request.resource.data.assignedUserName == profileName(ownProfile()) && request.resource.data.assignedAt == request.time
        && request.resource.data.completedAt == null && request.resource.data.completedByUserId == null && request.resource.data.completedByName == null
        && request.resource.data.withdrawnAt == null && request.resource.data.withdrawnByUserId == null;
    }
    function isCreatedTodo() {
      return todoKeysAreValid(request.resource.data) && validTodoContent(request.resource.data)
        && request.resource.data.creatorUserId == request.auth.uid && request.resource.data.creatorName == profileName(ownProfile())
        && (isCreatedOpenTodo() || isCreatedOwnTodo()) && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    }
    function isTakeover() {
      return resource.data.assignedUserId == null && resource.data.status != 'withdrawn' && isTodoAudienceMember(resource.data)
        && request.resource.data.status == 'in_progress' && request.resource.data.assignedUserId == request.auth.uid
        && request.resource.data.assignedUserName == profileName(ownProfile()) && request.resource.data.assignedAt == request.time
        && request.resource.data.completedAt == null && request.resource.data.completedByUserId == null && request.resource.data.completedByName == null
        && request.resource.data.withdrawnAt == null && request.resource.data.withdrawnByUserId == null
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedUserId', 'assignedUserName', 'assignedAt', 'status', 'completedAt', 'completedByUserId', 'completedByName', 'updatedAt']);
    }
    function isRelease() {
      return resource.data.status == 'in_progress' && resource.data.assignedUserId == request.auth.uid
        && !(resource.data.creatorUserId == request.auth.uid && resource.data.audienceType == 'person' && resource.data.audienceId == request.auth.uid)
        && hasOpenAssignment(request.resource.data) && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedUserId', 'assignedUserName', 'assignedAt', 'status', 'updatedAt']);
    }
    function isCompletion() {
      return resource.data.status == 'in_progress' && resource.data.assignedUserId == request.auth.uid
        && request.resource.data.status == 'completed' && request.resource.data.assignedUserId == request.auth.uid
        && request.resource.data.completedAt == request.time && request.resource.data.completedByUserId == request.auth.uid
        && request.resource.data.completedByName == profileName(ownProfile()) && request.resource.data.updatedAt == request.time
        && request.resource.data.withdrawnAt == null && request.resource.data.withdrawnByUserId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedByUserId', 'completedByName', 'updatedAt']);
    }
    function isReactivation() {
      return resource.data.status == 'completed' && resource.data.assignedUserId == request.auth.uid
        && resource.data.completedByUserId == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.completedAt == null && request.resource.data.completedByUserId == null && request.resource.data.completedByName == null
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedByUserId', 'completedByName', 'updatedAt']);
    }
    function isCreatorContentEdit() {
      return isCreatorOrSuperadmin() && resource.data.status in ['open', 'in_progress'] && validTodoContent(request.resource.data)
        && request.resource.data.status == resource.data.status && request.resource.data.assignedUserId == resource.data.assignedUserId
        && request.resource.data.assignedUserName == resource.data.assignedUserName && request.resource.data.assignedAt == resource.data.assignedAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'dueDate', 'reminderDate', 'priority', 'customerId', 'customerName', 'carrierId', 'carrierName', 'reference', 'damageCaseId', 'updatedAt']);
    }
    function isCreatorResetAssignment() {
      return isCreatorOrSuperadmin() && resource.data.status in ['open', 'in_progress'] && validTodoContent(request.resource.data)
        && hasOpenAssignment(request.resource.data) && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'dueDate', 'reminderDate', 'priority', 'customerId', 'customerName', 'carrierId', 'carrierName', 'reference', 'damageCaseId', 'audienceType', 'audienceId', 'audienceIds', 'audienceLabel', 'assignedUserId', 'assignedUserName', 'assignedAt', 'status', 'updatedAt']);
    }
    function isWithdrawal() {
      return isCreatorOrSuperadmin() && resource.data.status in ['open', 'in_progress']
        && request.resource.data.status == 'withdrawn' && request.resource.data.assignedUserId == null && request.resource.data.assignedUserName == null && request.resource.data.assignedAt == null
        && request.resource.data.withdrawnAt == request.time && request.resource.data.withdrawnByUserId == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnByUserId', 'assignedUserId', 'assignedUserName', 'assignedAt', 'updatedAt']);
    }
    function isNoteTimestampTouch() {
      return request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
    }
    function todoDocument(todoId) { return get(/databases/$(database)/documents/todos/$(todoId)).data; }
    function todoAfter(todoId) { return getAfter(/databases/$(database)/documents/todos/$(todoId)).data; }
    function validTodoUpdate(data) {
      return data.keys().hasAll(['text', 'type', 'createdByUserId', 'createdByName', 'createdAt'])
        && data.keys().hasOnly(['text', 'type', 'createdByUserId', 'createdByName', 'createdAt'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.type in ['note', 'system'] && data.createdByUserId == request.auth.uid
        && data.createdByName == profileName(ownProfile()) && data.createdAt == request.time;
    }
    match /todos/{id} {
      allow read: if view('todos') && canReadTodo(resource.data);
      allow create: if edit('todos') && isCreatedTodo();
      allow update: if (edit('todos') && todoKeysAreValid(request.resource.data) && (isTakeover() || isRelease() || isCompletion() || isReactivation() || isCreatorContentEdit() || isCreatorResetAssignment() || isWithdrawal()))
        || (view('todos') && todoKeysAreValid(request.resource.data) && isNoteTimestampTouch());
      allow delete: if false;

      match /updates/{updateId} {
        allow read: if view('todos') && canReadTodo(todoDocument(id));
        allow create: if view('todos') && canReadTodo(todoAfter(id)) && validTodoUpdate(request.resource.data)
          && (request.resource.data.type == 'note' || (request.resource.data.type == 'system' && edit('todos')));
        allow update, delete: if false;
      }
    }
    function ownVacationRequest(data) {
      return data.userId == request.auth.uid && data.type == 'vacation'
        && ((data.status == 'pending' && !data.keys().hasAny(['originalRequestId', 'changeRequest', 'cancellationRequest', 'requestKind']))
          || (data.status == 'cancellation_requested' && data.originalRequestId is string
          && exists(/databases/$(database)/documents/vacationRequests/$(data.originalRequestId))
          && get(/databases/$(database)/documents/vacationRequests/$(data.originalRequestId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/vacationRequests/$(data.originalRequestId)).data.status == 'approved'));
    }
    match /vacationRequests/{id} {
      allow read: if view('vacation') && (resource.data.userId == request.auth.uid || resource.data.status == 'approved');
      allow create: if edit('vacation') && ownVacationRequest(request.resource.data);
      // Approval, rejection and all other changes are handled by the callable
      // function, which validates the manager's department server-side.
      allow update, delete: if false;
    }
    // Payroll processing and internal HR notes are strictly separate from
    // vacation workflow documents and are exposed only through HR callables.
    match /hrVacationMeta/{vacationId} {
      allow read, write: if false;
    }
    match /vacationHistory/{id} {
      allow read: if view('vacation') && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /calendarHolidays/{id} { allow read: if view('vacation'); allow write: if superadmin(); }
    match /vacationBlocks/{id} { allow read: if view('vacation'); allow write: if superadmin(); }
  }
}
