      let first = profile.get('firstName', null);
      let last = profile.get('lastName', null);
      return (first is string && last is string && value == first + ' ' + last)
        ? true : value == profileName(profile);
    }
    function activeProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.active == true;
    }
    function noAudienceIds(data) {
      return data.get('audienceIds', null) == null;
    }
    function validTodoAudience(data) {
      let type = data.audienceType;
