rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? ownProfile().role : 'user'; }
    function superadmin() { return role() == 'superadmin'; }
    function admin() { return role() == 'admin' || superadmin(); }
    function level(module) { return superadmin() ? 'edit' : ownProfile().permissions[module]; }
    function view(module) { return signedIn() && (superadmin() || level(module) in ['view', 'edit']); }
    function edit(module) { return signedIn() && (superadmin() || level(module) == 'edit'); }
    function calendarDocument(calendarId) { return get(/databases/$(database)/documents/calendars/$(calendarId)).data; }
    function calendarPermissionLevel(calendarId) {
      return exists(/databases/$(database)/documents/calendarPermissions/$(calendarId + '_' + request.auth.uid))
        ? get(/databases/$(database)/documents/calendarPermissions/$(calendarId + '_' + request.auth.uid)).data.level
        : 'none';
    }
    function canReadCalendar(calendarId) {
      return superadmin() || calendarDocument(calendarId).ownerUserId == request.auth.uid || calendarPermissionLevel(calendarId) in ['view', 'edit'];
    }
    function canEditCalendar(calendarId) {
      return superadmin() || (calendarDocument(calendarId).active != false && (calendarDocument(calendarId).ownerUserId == request.auth.uid || calendarPermissionLevel(calendarId) == 'edit'));
    }
    function validPersonalCalendar(calendarId, data) {
      return calendarId == 'personal-' + request.auth.uid
        && data.keys().hasAll(['name', 'color', 'kind', 'ownerUserId', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'color', 'kind', 'ownerUserId', 'active', 'createdAt', 'updatedAt'])
        && data.name == 'Mein Kalender' && data.kind == 'personal' && data.ownerUserId == request.auth.uid
        && data.active == true && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function validCalendarEvent(data) {
      return data.keys().hasAll(['title', 'description', 'startDate', 'endDate', 'allDay', 'startTime', 'endTime', 'createdByUserId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'description', 'startDate', 'endDate', 'allDay', 'startTime', 'endTime', 'createdByUserId', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 4000
        && data.startDate is string && data.startDate.size() == 10 && data.endDate is string && data.endDate.size() == 10 && data.endDate >= data.startDate
        && data.allDay is bool && data.startTime is string && data.endTime is string
        && data.createdByUserId is string;
    }

    match /users/{userId} {
      allow get: if signedIn() && (userId == request.auth.uid || admin() || view('team'));
      allow list: if admin() || view('team') || view('vacation') || edit('todos');
      // Accounts are only created by the Admin SDK callable function.
      allow create, delete: if false;
      allow update: if superadmin() || (admin() && resource.data.role == 'user'
        && request.resource.data.role == resource.data.role
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'birthDate', 'phone', 'email', 'jobTitle', 'department', 'active', 'employmentStart', 'personnelNumber', 'updatedAt']));
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      // Central department maintenance runs through superadmin-only callable functions.
      allow write: if false;
    }

    match /calendars/{calendarId} {
      allow get: if view('calendar') && canReadCalendar(calendarId);
      allow list: if view('calendar') && superadmin();
      // Personal calendars are provisioned on first use. Shared calendars and
      // their lifecycle are deliberately restricted to superadmins.
      allow create: if superadmin() || (view('calendar') && validPersonalCalendar(calendarId, request.resource.data));
      allow update: if superadmin();
      allow delete: if false;

      match /events/{eventId} {
        allow read: if view('calendar') && canReadCalendar(calendarId);
        allow create: if view('calendar') && canEditCalendar(calendarId) && validCalendarEvent(request.resource.data)
          && request.resource.data.createdByUserId == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if view('calendar') && canEditCalendar(calendarId) && validCalendarEvent(request.resource.data)
          && request.resource.data.createdByUserId == resource.data.createdByUserId && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
        allow delete: if view('calendar') && canEditCalendar(calendarId);
      }
    }

    match /calendarPermissions/{permissionId} {
      allow read: if view('calendar') && (superadmin() || resource.data.userId == request.auth.uid);
      allow create, update: if superadmin()
        && request.resource.data.keys().hasAll(['calendarId', 'userId', 'level', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['calendarId', 'userId', 'level', 'updatedAt'])
        && request.resource.data.calendarId is string && request.resource.data.userId is string
        && request.resource.data.level in ['none', 'view', 'edit'] && request.resource.data.updatedAt == request.time;
      allow delete: if superadmin();
    }

    match /businessPartners/{partnerId} {
      allow read: if view('masterData') || view('crm') || view('pallets');
      allow create, delete: if edit('masterData');
      allow update: if edit('masterData') || (edit('crm') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creditLimit', 'crmStatus', 'potential', 'updatedAt']));
      match /history/{entryId} { allow read: if view('masterData') || view('crm'); allow create: if edit('masterData') || edit('crm'); allow update, delete: if false; }
      match /activities/{entryId} { allow read: if view('crm'); allow create, update: if edit('crm'); allow delete: if false; }
      match /ratings/{ratingId} { allow read: if view('crm'); allow create: if edit('crm'); allow update, delete: if false; }
    }

    match /palletMovements/{id} { allow read: if view('pallets'); allow create, update, delete: if edit('pallets'); }
    match /palletClosings/{id} { allow read: if view('pallets'); allow create, update, delete: if edit('pallets'); }
    match /newsItems/{id} { allow read: if view('news'); allow create, update, delete: if edit('news'); }
    match /internalDocuments/{id} { allow read: if view('documents'); allow create, update, delete: if edit('documents'); }
    function todoKeysAreValid(data) {
      return data.keys().hasAll(['title', 'description', 'dueDate', 'creatorUserId', 'creatorName', 'audienceType', 'audienceId', 'audienceLabel', 'assignedUserId', 'assignedUserName', 'assignedAt', 'status', 'completedAt', 'completedByUserId', 'completedByName', 'withdrawnAt', 'withdrawnByUserId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'description', 'dueDate', 'creatorUserId', 'creatorName', 'audienceType', 'audienceId', 'audienceLabel', 'assignedUserId', 'assignedUserName', 'assignedAt', 'status', 'completedAt', 'completedByUserId', 'completedByName', 'withdrawnAt', 'withdrawnByUserId', 'createdAt', 'updatedAt']);
    }
    function profileName(profile) { return profile.firstName + ' ' + profile.lastName; }
    function activeProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.active != false;
    }
    function validTodoAudience(data) {
      return (data.audienceType == 'all' && data.audienceId == null && data.audienceLabel == 'Alle')
        || (data.audienceType == 'department' && data.audienceId is string && data.audienceId.size() > 0 && data.audienceLabel == data.audienceId)
        || (data.audienceType == 'person' && data.audienceId is string && activeProfile(data.audienceId)
          && data.audienceLabel == profileName(get(/databases/$(database)/documents/users/$(data.audienceId)).data));
    }
    function validTodoContent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 240
        && data.description is string && data.description.size() <= 4000
        && (data.dueDate == null || data.dueDate is string)
        && validTodoAudience(data);
    }
    function isTodoAudienceMember(data) {
      return data.audienceType == 'all'
        || (data.audienceType == 'person' && data.audienceId == request.auth.uid)
        || (data.audienceType == 'department' && data.audienceId == ownProfile().department);
    }
    function canReadTodo(data) {
      return superadmin() || data.creatorUserId == request.auth.uid || data.assignedUserId == request.auth.uid
        || (data.status != 'withdrawn' && isTodoAudienceMember(data));
    }
    function isCreatorOrSuperadmin() { return superadmin() || resource.data.creatorUserId == request.auth.uid; }
    function hasOpenAssignment(data) {
      return data.status == 'open' && data.assignedUserId == null && data.assignedUserName == null && data.assignedAt == null
        && data.completedAt == null && data.completedByUserId == null && data.completedByName == null
        && data.withdrawnAt == null && data.withdrawnByUserId == null;
    }
    function isCreatedTodo() {
      return todoKeysAreValid(request.resource.data) && validTodoContent(request.resource.data)
        && request.resource.data.creatorUserId == request.auth.uid && request.resource.data.creatorName == profileName(ownProfile())
        && hasOpenAssignment(request.resource.data) && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    }
    function isTakeover() {
      return resource.data.status == 'open' && resource.data.assignedUserId == null && isTodoAudienceMember(resource.data)
        && request.resource.data.status == 'in_progress' && request.resource.data.assignedUserId == request.auth.uid
        && request.resource.data.assignedUserName == profileName(ownProfile()) && request.resource.data.assignedAt == request.time
        && request.resource.data.completedAt == null && request.resource.data.completedByUserId == null && request.resource.data.completedByName == null
        && request.resource.data.withdrawnAt == null && request.resource.data.withdrawnByUserId == null
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedUserId', 'assignedUserName', 'assignedAt', 'status', 'updatedAt']);
    }
    function isRelease() {
      return resource.data.status == 'in_progress' && resource.data.assignedUserId == request.auth.uid
        && hasOpenAssignment(request.resource.data) && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedUserId', 'assignedUserName', 'assignedAt', 'status', 'updatedAt']);
    }
    function isCompletion() {
      return resource.data.status == 'in_progress' && resource.data.assignedUserId == request.auth.uid
        && request.resource.data.status == 'completed' && request.resource.data.assignedUserId == request.auth.uid
        && request.resource.data.completedAt == request.time && request.resource.data.completedByUserId == request.auth.uid
        && request.resource.data.completedByName == profileName(ownProfile()) && request.resource.data.updatedAt == request.time
        && request.resource.data.withdrawnAt == null && request.resource.data.withdrawnByUserId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedByUserId', 'completedByName', 'updatedAt']);
    }
    function isCreatorContentEdit() {
      return isCreatorOrSuperadmin() && resource.data.status in ['open', 'in_progress'] && validTodoContent(request.resource.data)
        && request.resource.data.status == resource.data.status && request.resource.data.assignedUserId == resource.data.assignedUserId
        && request.resource.data.assignedUserName == resource.data.assignedUserName && request.resource.data.assignedAt == resource.data.assignedAt
        && request.resource.data.audienceType == resource.data.audienceType && request.resource.data.audienceId == resource.data.audienceId && request.resource.data.audienceLabel == resource.data.audienceLabel
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'dueDate', 'updatedAt']);
    }
    function isCreatorResetAssignment() {
      return isCreatorOrSuperadmin() && resource.data.status in ['open', 'in_progress'] && validTodoContent(request.resource.data)
        && hasOpenAssignment(request.resource.data) && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'dueDate', 'audienceType', 'audienceId', 'audienceLabel', 'assignedUserId', 'assignedUserName', 'assignedAt', 'status', 'updatedAt']);
    }
    function isWithdrawal() {
      return isCreatorOrSuperadmin() && resource.data.status in ['open', 'in_progress']
        && request.resource.data.status == 'withdrawn' && request.resource.data.assignedUserId == null && request.resource.data.assignedUserName == null && request.resource.data.assignedAt == null
        && request.resource.data.withdrawnAt == request.time && request.resource.data.withdrawnByUserId == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnByUserId', 'assignedUserId', 'assignedUserName', 'assignedAt', 'updatedAt']);
    }
    match /todos/{id} {
      allow read: if view('todos') && canReadTodo(resource.data);
      allow create: if edit('todos') && isCreatedTodo();
      allow update: if edit('todos') && todoKeysAreValid(request.resource.data) && (isTakeover() || isRelease() || isCompletion() || isCreatorContentEdit() || isCreatorResetAssignment() || isWithdrawal());
      allow delete: if false;
    }
    function ownVacationRequest(data) {
      return data.userId == request.auth.uid && data.type == 'vacation'
        && data.status in ['pending', 'change_requested', 'cancellation_requested'];
    }
    match /vacationRequests/{id} {
      allow read: if view('vacation') && (resource.data.userId == request.auth.uid || resource.data.status == 'approved');
      allow create: if edit('vacation') && ownVacationRequest(request.resource.data);
      // Approval, rejection and all other changes are handled by the callable
      // function, which validates the manager's department server-side.
      allow update, delete: if false;
    }
    match /calendarHolidays/{id} { allow read: if view('vacation'); allow write: if superadmin(); }
    match /vacationBlocks/{id} { allow read: if view('vacation'); allow write: if superadmin(); }
  }
}
