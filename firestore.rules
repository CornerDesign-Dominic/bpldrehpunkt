rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? ownProfile().role : 'user'; }
    // A usable account always has an explicitly confirmed active profile.
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && ownProfile().active == true; }
    // Role helpers include the active-profile gate so direct rule branches
    // cannot accidentally grant a disabled administrator elevated access.
    function superadmin() { return active() && role() == 'superadmin'; }
    function admin() { return active() && (role() == 'admin' || superadmin()); }
    function level(module) { return superadmin() ? 'edit' : ownProfile().permissions[module]; }
    function view(module) { return active() && (superadmin() || level(module) in ['view', 'edit']); }
    function edit(module) { return active() && (superadmin() || level(module) == 'edit'); }
    // These identifiers are virtual system calendars. Their entries always
    // remain in the protected source case files and can never be created or
    // administered as ordinary calendar documents.
    function systemCalendarId(calendarId) {
      return calendarId in ['system-damages', 'system-insolvencies', 'system-legal-disputes', 'system-inkasso', 'system-contracts'];
    }
    function calendarDocument(calendarId) { return get(/databases/$(database)/documents/calendars/$(calendarId)).data; }
    function calendarPermissionLevel(calendarId) {
      return exists(/databases/$(database)/documents/calendarPermissions/$(calendarId + '_' + request.auth.uid))
        ? get(/databases/$(database)/documents/calendarPermissions/$(calendarId + '_' + request.auth.uid)).data.level
        : 'none';
    }
    function canReadCalendar(calendarId) {
      return superadmin() || calendarDocument(calendarId).ownerUserId == request.auth.uid || calendarPermissionLevel(calendarId) in ['view', 'edit'];
    }
    function canEditCalendar(calendarId) {
      return superadmin() || (calendarDocument(calendarId).active != false && (calendarDocument(calendarId).ownerUserId == request.auth.uid || calendarPermissionLevel(calendarId) == 'edit'));
    }
    function validPersonalCalendar(calendarId, data) {
      return calendarId == 'personal-' + request.auth.uid
        && data.keys().hasAll(['name', 'color', 'kind', 'ownerUserId', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'color', 'kind', 'ownerUserId', 'active', 'createdAt', 'updatedAt'])
        && data.name == 'Mein Kalender' && data.kind == 'personal' && data.ownerUserId == request.auth.uid
        && data.active == true && data.createdAt == request.time && data.updatedAt == request.time;
    }
    // Reminder wall-clock validation is deliberately independent of recipient
    // addresses. The central server resolves current authorized users and DST.
    function validReminderLeapYear(value) {
      let year = int(value.split('-')[0]);
      return year >= 1 && (year % 400 == 0 || (year % 4 == 0 && year % 100 != 0));
    }
    function validReminderDate(value) {
      // Month-specific day ranges avoid expanding integer/calendar arithmetic
      // on every atomic case/task write. Only February 29 needs a leap check.
      return value is string && !value.matches('^0000-.*')
        && (value.matches('^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))$')
          || (value.matches('^[0-9]{4}-02-29$') && validReminderLeapYear(value)));
    }
    function validReminderTime(value) { return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function validReminderOccurrence(data) {
      let occurrence = data.get('reminderOccurrence', null);
      return occurrence == null || occurrence in ['earlier', 'later'];
    }
    function optionalReminderSchedule(data) {
      return (data.get('reminderDate', null) == null || validReminderDate(data.get('reminderDate', null)))
        && (data.get('reminderTime', null) == null || validReminderTime(data.get('reminderTime', null))) && validReminderOccurrence(data);
    }
    function completeReminderSchedule(data) { return validReminderDate(data.get('reminderDate', null)) && validReminderTime(data.get('reminderTime', null)) && validReminderOccurrence(data); }
    function mainReminderUnchanged(before, after) {
      return before.get('reminderDate', null) == after.get('reminderDate', null)
        && before.get('reminderTime', null) == after.get('reminderTime', null)
        && before.get('reminderOccurrence', null) == after.get('reminderOccurrence', null);
    }
    function validNewTodoReminderSchedule(data) { return data.get('reminderDate', null) == null ? data.get('reminderTime', null) == null && validReminderOccurrence(data) : completeReminderSchedule(data); }
    function validChangedTodoReminderSchedule(before, after) { return mainReminderUnchanged(before, after) || validNewTodoReminderSchedule(after); }
    function validCalendarReminder(data) {
      return data.get('reminderEnabled', false) is bool && optionalReminderSchedule(data)
        && (!data.get('reminderEnabled', false) || completeReminderSchedule(data));
    }
    function validDeadlineReminderFields(data) {
      return validReminderDate(data.date) && (data.get('time', null) == null || validReminderTime(data.get('time', null))) && validReminderOccurrence(data);
    }
    function validNewDeadlineReminder(data) {
      return (!data.reminderEnabled || validReminderTime(data.get('time', null)))
        && (!data.keys().hasAny(['reminderRecipientEmail']) || data.reminderRecipientEmail == null || data.reminderRecipientEmail == ownProfile().email);
    }
    function validChangedDeadlineReminder(before, after) {
      return !after.diff(before).affectedKeys().hasAny(['reminderRecipientEmail'])
        && (!after.reminderEnabled || validReminderTime(after.get('time', null))
          || !after.diff(before).affectedKeys().hasAny(['date', 'time', 'reminderEnabled', 'reminderOccurrence']));
    }
    function responsibilityUnchanged(before, after) { return !after.diff(before).affectedKeys().hasAny(['responsibleUserId', 'responsibleUserName']); }
    function validCaseReminderResponsible(data, module) {
      let userId = data.get('responsibleUserId', null);
      let name = data.get('responsibleUserName', null);
      return (userId == null && name == null)
        || (userId is string && name is string && activeProfile(userId)
          && (get(/databases/$(database)/documents/users/$(userId)).data.role == 'superadmin'
            || get(/databases/$(database)/documents/users/$(userId)).data.get('permissions', {}).get(module, 'none') in ['view', 'edit'])
          && name == profileName(get(/databases/$(database)/documents/users/$(userId)).data));
    }

    function validCalendarEvent(data) {
      return data.keys().hasAll(['title', 'description', 'startDate', 'endDate', 'allDay', 'startTime', 'endTime', 'createdByUserId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'description', 'startDate', 'endDate', 'allDay', 'startTime', 'endTime', 'createdByUserId', 'createdAt', 'updatedAt', 'reminderEnabled', 'reminderDate', 'reminderTime', 'reminderOccurrence'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 4000
        && data.startDate is string && data.startDate.size() == 10 && data.endDate is string && data.endDate.size() == 10 && data.endDate >= data.startDate
        && data.allDay is bool && data.startTime is string && data.endTime is string
        && data.createdByUserId is string && validCalendarReminder(data);
    }

    match /users/{userId} {
      // A client may read its own complete profile only.  Team, vacation and
      // to-do directories are supplied as deliberately reduced data by a
      // callable function; they must never grant direct profile access.
      // Complete profiles can contain account-security data. Administration
      // receives its deliberately reduced view through listManagedUsers.
      allow get: if active() && userId == request.auth.uid;
      allow list: if false;
      // Accounts are only created by the Admin SDK callable function.
      allow create, delete: if false;
      allow update: if false;

      // Persönliche Notizen gehören ausschließlich ihrem Ersteller. Sie sind
      // weder Teil des Teamprofils noch für Administratoren einsehbar.
      match /personalNotes/{noteId} {
        function validPersonalNote(data) {
          return data.keys().hasAll(['title', 'text', 'importance', 'urgency', 'createdAt', 'updatedAt'])
            && data.keys().hasOnly(['title', 'text', 'importance', 'urgency', 'createdAt', 'updatedAt'])
            && data.title is string && data.title.size() > 0 && data.title.size() <= 140
            && data.text is string && data.text.size() > 0 && data.text.size() <= 12000
            && data.importance in ['low', 'high'] && data.urgency in ['low', 'high'];
        }
        allow read: if active() && userId == request.auth.uid;
        allow create: if active() && userId == request.auth.uid && validPersonalNote(request.resource.data)
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if active() && userId == request.auth.uid && validPersonalNote(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'text', 'importance', 'urgency', 'updatedAt']);
        allow delete: if active() && userId == request.auth.uid;
      }
    }

    // Personal data is intentionally callable-only. This blocks all direct
    // reads, writes and manipulated client requests, including for admins.
    match /employeeHrProfiles/{userId} {
      allow read, write: if false;
    }

    match /departments/{departmentId} {
      allow read: if active();
      // Central department maintenance runs through superadmin-only callable functions.
      allow write: if false;
    }

    // Quality records and their immutable snapshots are written together by
    // saveQualityRecord after module, department and revision validation.
    match /qualityTopics/{id} {
      allow read: if view('kvp');
      allow write: if false;
      match /revisions/{revision} { allow read: if view('kvp'); allow write: if false; }
    }
    match /qualityMeetings/{id} {
      allow read: if view('kvp');
      allow write: if false;
      match /revisions/{revision} { allow read: if view('kvp'); allow write: if false; }
    }
    match /qualityHandbook/{id} {
      allow read: if view('handbook');
      allow write: if false;
      match /revisions/{revision} { allow read: if view('handbook'); allow write: if false; }
    }

    // Process knowledge and rules share the existing handbook permission.
    // Validated callables own all writes and immutable revision snapshots.
    match /knowledgeArticles/{id} {
      allow read: if view('handbook');
      allow write: if false;
      match /revisions/{revision} { allow read: if view('handbook'); allow write: if false; }
    }
    match /knowledgeRules/{id} {
      allow read: if view('handbook');
      allow write: if false;
      match /revisions/{revision} { allow read: if view('handbook'); allow write: if false; }
    }
    match /knowledgeGaps/{id} {
      allow read: if view('knowledgeGaps');
      allow write: if false;
      match /{document=**} { allow read, write: if false; }
    }
    match /knowledgeGapEvidence/{id} {
      allow read: if view('knowledgeGaps');
      allow write: if false;
    }
    match /knowledgeLearningRuns/{id} {
      allow read: if view('knowledgeGaps') && view('handbook');
      allow write: if false;
    }
    match /knowledgeGapOccurrences/{id} {
      allow read, write: if false;
    }

    match /appSettings/partnerEvaluation {
      // Evaluation colors are part of the signed-in client presentation, but
      // settings may only be changed by the Admin SDK callable function.
      allow read: if active();
      allow write: if false;
    }

    // Company details feed shared document templates. Only the validated admin
    // callable can change them; every active account may read them.
    match /appSettings/companyMasterData {
      allow read: if active();
      allow write: if false;
    }

    // The company holiday region is a global display setting. Every active
    // work-calendar user may read it; updates are exclusively validated by a
    // callable Cloud Function for admins and superadmins.
    match /appSettings/holidayCalendar {
      allow read: if active();
      allow write: if false;
    }

    // Shipment-tracking operating hours are a centrally maintained automation
    // prerequisite. Only active admins may read them; every write goes through
    // the validated App Check callable function.
    match /systemSettings/shipmentTrackingOperatingHours {
      allow read: if admin();
      allow write: if false;
    }

    // The short-notice arrival confirmation is administered separately from
    // the regular rule catalogue. Writes are validated by its callable.
    match /systemSettings/shipmentTrackingArrivalConfirmation {
      allow read: if admin();
      allow write: if false;
    }

    // Partner cards read the centrally maintained rule catalog; changes remain
    // restricted to the validated Admin/App Check callable.
    match /systemSettings/shipmentTrackingRuleCatalog {
      allow read: if admin() || view('masterData');
      allow write: if false;
    }

    // Forecast thresholds and vehicle mappings are read by transport-order
    // users for the explanation only; all changes remain callable-only.
    match /systemSettings/shipmentTrackingForecast {
      allow read: if admin() || view('transportOrders');
      allow write: if false;
    }

    // The automatic-mail emergency switch is visible only to the people who
    // may operate it. Updates are exclusively validated by a superadmin
    // callable function.
    match /systemSettings/automaticMailDelivery {
      allow read: if superadmin();
      allow write: if false;
    }

    // The client only reads the server-maintained public holiday projection.
    // Nager.Date access and every write remain exclusively in Cloud Functions.
    match /publicHolidays/{holidayId} {
      // Work calendars use the server-maintained German holiday projection
      // independently of the standalone Feiertagskalender module right.
      allow read: if active();
      allow write: if false;
    }

    match /holidaySyncStatus/{countryCode} {
      allow read: if admin();
      allow write: if false;
    }

    match /holidaySyncLogs/{logId} {
      allow read: if admin();
      allow write: if false;
    }

    // School holidays are an independent, server-maintained projection used
    // only by the standalone Feiertagskalender. No client may alter data or
    // synchronization history.
    match /schoolHolidays/{holidayId} {
      allow read: if view('feiertagskalender');
      allow write: if false;
    }

    match /schoolHolidaySyncStatus/{countryCode} {
      allow read: if admin();
      allow write: if false;
    }

    match /schoolHolidaySyncLogs/{logId} {
      allow read: if admin();
      allow write: if false;
    }

    // Systemmail templates are exclusively exposed through superadmin-only
    // callable functions. This keeps delivery and recipient controls out of
    // direct client access.
    match /systemMailTemplates/{templateId} {
      allow read, write: if false;
    }

    // KI-Prompts are callable-only. Published content is never supplied by a
    // browser request and cannot be modified by direct Firestore access.
    match /aiPromptConfigs/{featureId} {
      allow read, write: if false;
    }

    // Legacy-account migration is an Admin SDK-only audit trail.
    match /legacyAccountMigrations/{id} {
      allow read, write: if false;
    }

    // KI-Usage wird ausschließlich durch Cloud Functions erfasst. Weder
    // Nutzer noch Clients dürfen Nutzungs- oder Kostendaten manipulieren.
    match /aiUsage/{id} {
      allow read, write: if false;
    }

    // AGB-Prüfer usage is written exclusively by Cloud Functions. There is
    // deliberately no client or general-admin read path; future reporting is
    // restricted to a superadmin-only callable function.
    match /agbCheckerUsage/{id} {
      allow read, write: if false;
    }

    // Successful AGB reviews are shared with everyone who may use the checker.
    // Only the callable function can add records; clients cannot change history.
    match /agbCheckerHistory/{id} {
      allow read: if view('agbChecker');
      allow write: if false;

      match /data/{dataId} {
        allow get: if view('agbChecker');
        allow list, write: if false;
      }
    }

    match /calendars/{calendarId} {
      // The own calendar is created lazily. Its initial get must be permitted
      // even before the document exists, otherwise provisioning can never run.
      allow get: if !systemCalendarId(calendarId) && view('calendar')
        && (calendarId == 'personal-' + request.auth.uid || canReadCalendar(calendarId));
      allow list: if view('calendar') && superadmin();
      // Personal calendars are provisioned on first use. Shared calendars and
      // their lifecycle are deliberately restricted to superadmins.
      allow create: if !systemCalendarId(calendarId) && (superadmin() || (view('calendar') && validPersonalCalendar(calendarId, request.resource.data)));
      allow update: if !systemCalendarId(calendarId) && (superadmin() || (view('calendar') && resource.data.kind == 'personal' && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.color == '#c99a3d' && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['color', 'updatedAt'])));
      allow delete: if false;

      match /events/{eventId} {
        allow read: if !systemCalendarId(calendarId) && view('calendar') && canReadCalendar(calendarId);
        allow create: if !systemCalendarId(calendarId) && view('calendar') && canEditCalendar(calendarId) && validCalendarEvent(request.resource.data)
          && request.resource.data.createdByUserId == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if !systemCalendarId(calendarId) && view('calendar') && canEditCalendar(calendarId) && validCalendarEvent(request.resource.data)
          && request.resource.data.createdByUserId == resource.data.createdByUserId && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
        allow delete: if !systemCalendarId(calendarId) && view('calendar') && canEditCalendar(calendarId);
      }
    }

    match /calendarPermissions/{permissionId} {
      allow read: if view('calendar') && (superadmin() || resource.data.userId == request.auth.uid);
      allow create, update: if superadmin() && !systemCalendarId(request.resource.data.calendarId)
        && request.resource.data.keys().hasAll(['calendarId', 'userId', 'level', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['calendarId', 'userId', 'level', 'updatedAt'])
        && request.resource.data.calendarId is string && request.resource.data.userId is string
        && request.resource.data.level in ['none', 'view', 'edit'] && request.resource.data.updatedAt == request.time;
      allow delete: if superadmin() && !systemCalendarId(resource.data.calendarId);
    }

    function partnerMergeFields() {
      return ['mergedIntoPartnerId', 'mergedIntoPartnerName', 'mergedByMergeId', 'mergedAt', 'mergedBy',
        'statusBeforeMerge', 'latestMergeId', 'lastSeparatedMergeId', 'separatedAt'];
    }
    function partnerHasNormalStatus(data) {
      return data.get('status', 'active') in ['active', 'inactive', 'insolvency', 'blocked'];
    }
    function trustedPartnerAccounts(data) {
      let refs = data.get('dycosReferences', {});
      return refs is map ? refs.get('accounts', []) : [];
    }

    match /businessPartners/{partnerId} {
      allow read: if view('masterData') || view('crm') || view('pallets');
      // XML export trusts these SQL-ID mappings. Only validated server imports
      // may create/change them; a superadmin client has no bypass.
      allow create: if edit('masterData') && partnerHasNormalStatus(request.resource.data) && !request.resource.data.keys().hasAny(partnerMergeFields())
        && !request.resource.data.keys().hasAny(['dycosIdentities', 'dycosImport'])
        && trustedPartnerAccounts(request.resource.data).size() == 0;
      allow delete: if false;
      allow update: if partnerHasNormalStatus(request.resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(partnerMergeFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dycosIdentities', 'dycosImport'])
        && trustedPartnerAccounts(request.resource.data) == trustedPartnerAccounts(resource.data)
        && ((resource.data.get('dycosIdentities', {}).size() == 0 && trustedPartnerAccounts(resource.data).size() == 0) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['debtorNumber', 'creditorNumber', 'dycosReferences']))
        && ((edit('masterData') && !resource.data.keys().hasAny(['mergedIntoPartnerId'])) || (edit('crm') && !resource.data.keys().hasAny(['mergedIntoPartnerId']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creditLimit', 'crmStatus', 'crmIndustry', 'potential', 'updatedAt'])) || insolvencyStatusUpdate(partnerId));
      match /history/{entryId} {
        allow read: if view('masterData') || view('crm');
        allow create: if (edit('masterData') || edit('crm'))
          && request.resource.data.get('category', '') != 'merge'
          && !(request.resource.data.get('action', '') in ['merged', 'mergedInto', 'separated'])
          && !request.resource.data.keys().hasAny(['mergeId']);
        allow update, delete: if false;
      }
      match /activities/{entryId} { allow read: if view('crm'); allow create, update: if edit('crm'); allow delete: if false; }
      match /ratings/{ratingId} { allow read: if view('crm'); allow create: if edit('crm'); allow update, delete: if false; }
    }

    // Merge snapshots and reference journals contain sensitive data and are callable-only.
    match /partnerMergeOperations/{mergeId} {
      allow read, write: if false;
      match /{subcollection}/{entryId} { allow read, write: if false; }
    }

    // Transportaufträge are written exclusively by the import callable. This
    // keeps import authorization and idempotent updates server-controlled.
    match /transportOrders/{transportOrderId} {
      allow read: if view('transportOrders');
      allow write: if false;
      match /history/{entryId} { allow read: if view('transportOrders'); allow write: if false; }
      match /refreshes/{entryId} { allow read: if view('transportOrders'); allow write: if false; }
      match /receivedMails/{mailId} { allow read: if view('transportOrders'); allow write: if false; }
    }

    // Own TA ratings are validated and written by the callable functions.
    match /transportOrderRatings/{ratingId} {
      allow read, write: if false;
    }

    // A link is deliberately a small, central relation document. It stores
    // only stable document IDs; titles and business data stay in their source
    // documents. Reads require access to both sides of the relation.
    function caseTransportLinkCaseVisible(data) {
      return (data.caseType == 'damage' && view('damages'))
        || (data.caseType == 'inkasso' && view('inkasso'))
        || (data.caseType == 'legalDispute' && view('legalDisputes'))
        || (data.caseType == 'insolvency' && view('insolvencies'));
    }
    function caseTransportLinkCaseEditable(data) {
      return (data.caseType == 'damage' && damageEditor())
        || (data.caseType == 'inkasso' && edit('inkasso'))
        || (data.caseType == 'legalDispute' && edit('legalDisputes'))
        || (data.caseType == 'insolvency' && edit('insolvencies'));
    }
    function caseTransportLinkCaseExists(data) {
      return (data.caseType == 'damage' && existsAfter(/databases/$(database)/documents/damageCases/$(data.caseId)))
        || (data.caseType == 'inkasso' && existsAfter(/databases/$(database)/documents/inkassoCases/$(data.caseId)))
        || (data.caseType == 'legalDispute' && existsAfter(/databases/$(database)/documents/legalDisputes/$(data.caseId)))
        || (data.caseType == 'insolvency' && existsAfter(/databases/$(database)/documents/insolvencies/$(data.caseId))
          && getAfter(/databases/$(database)/documents/insolvencies/$(data.caseId)).data.get('mergedIntoPartnerId', null) == null
          && getAfter(/databases/$(database)/documents/insolvencies/$(data.caseId)).data.get('splitArchivedAt', null) == null);
    }
    function validCaseTransportLink(data, linkId) {
      return data.keys().hasAll(['caseType', 'caseId', 'transportOrderId', 'createdAt', 'createdByUserId', 'createdByName'])
        && data.keys().hasOnly(['caseType', 'caseId', 'transportOrderId', 'createdAt', 'createdByUserId', 'createdByName'])
        && data.caseType in ['damage', 'inkasso', 'legalDispute', 'insolvency']
        && data.caseId is string && data.caseId.size() > 0 && data.caseId.size() <= 240 && !data.caseId.matches('.*[/|].*')
        && data.transportOrderId is string && data.transportOrderId.size() > 0 && data.transportOrderId.size() <= 240 && !data.transportOrderId.matches('.*[/|].*')
        && linkId == data.caseType + '|' + data.caseId + '|' + data.transportOrderId
        && data.createdAt == request.time && data.createdByUserId == request.auth.uid && data.createdByName == profileName(ownProfile());
    }
    match /caseTransportOrderLinks/{linkId} {
      allow read: if view('transportOrders') && caseTransportLinkCaseVisible(resource.data);
      allow create: if view('transportOrders') && caseTransportLinkCaseEditable(request.resource.data)
        && validCaseTransportLink(request.resource.data, linkId) && caseTransportLinkCaseExists(request.resource.data)
        && exists(/databases/$(database)/documents/transportOrders/$(request.resource.data.transportOrderId));
      allow update: if false;
      allow delete: if view('transportOrders') && caseTransportLinkCaseEditable(resource.data);
    }
    // Manuelle Sendungsverfolgung bleibt getrennt von den importierten
    // Auftragsdaten. Alle Änderungen und die unveränderbare Historie werden
    // ausschließlich durch das berechtigte Callable mit Admin SDK geschrieben.
    match /transportOrderTrackings/{transportOrderId} {
      allow read: if view('transportOrders');
      allow write: if false;
      match /events/{eventId} {
        allow read: if view('transportOrders');
        allow write: if false;
      }
    }

    // Grobe Ort-zu-Ort-Routen sind getrennt von den importierten Aufträgen.
    // Berechnung, Cache und Nutzungsprotokoll bleiben serverseitig kontrolliert.
    match /transportOrderRoutes/{transportOrderId} {
      allow read: if view('transportOrders');
      allow write: if false;
      match /calculations/{calculationId} { allow read: if view('transportOrders'); allow write: if false; }
    }
    match /tomTomGeocodeCache/{cacheId} { allow read, write: if false; }
    match /tomTomUsageEvents/{eventId} { allow read, write: if false; }
    match /tomTomUsageMonths/{month} { allow read, write: if false; }
    match /reminderWork/{document=**} { allow read, write: if false; }
    match /reminderDeliveries/{document=**} { allow read, write: if false; }
    match /reminderSourceStatus/{document=**} { allow read, write: if false; }
    match /reminderState/{document=**} { allow read, write: if false; }
    // Diagnostic history is written by server functions and exposed only
    // through an admin-gated callable with bounded, filtered pagination.
    match /diagnosticEvents/{eventId} { allow read, write: if false; }

    match /transportOrderImportRuns/{runId} {
      allow read, write: if false;
    }

    function insolvencyText(value, limit) { return value == null || (value is string && value.size() <= limit); }
    function insolvencyDate(value) { return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function insolvencyKeysAreValid(data) {
      return data.keys().hasAll(['partnerId', 'partnerName', 'insolvencyDate', 'knownDate', 'courtReference', 'courtVenue', 'description', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'])
        && data.keys().hasOnly(['partnerId', 'partnerName', 'insolvencyDate', 'knownDate', 'courtReference', 'courtVenue', 'description', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName', 'responsibleUserId', 'responsibleUserName']);
    }
    function validInsolvency(data, partnerId) {
      return data.partnerId == partnerId && data.partnerName is string && data.partnerName.size() > 0 && data.partnerName.size() <= 500
        && insolvencyDate(data.insolvencyDate) && insolvencyDate(data.knownDate) && insolvencyText(data.courtReference, 240) && insolvencyText(data.courtVenue, 240) && insolvencyText(data.description, 4000);
    }
    function createdInsolvency(partnerId) {
      return insolvencyKeysAreValid(request.resource.data) && validInsolvency(request.resource.data, partnerId) && validCaseReminderResponsible(request.resource.data, 'insolvencies')
        && exists(/databases/$(database)/documents/businessPartners/$(partnerId))
        && get(/databases/$(database)/documents/businessPartners/$(partnerId)).data.get('mergedIntoPartnerId', null) == null
        && get(/databases/$(database)/documents/businessPartners/$(partnerId)).data.get('status', '') != 'merged'
        && request.resource.data.partnerName == get(/databases/$(database)/documents/businessPartners/$(partnerId)).data.companyName
        && getAfter(/databases/$(database)/documents/businessPartners/$(partnerId)).data.status == 'insolvency'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdByName == profileName(ownProfile()) && request.resource.data.updatedByName == profileName(ownProfile());
    }
    function updatedInsolvency(partnerId) {
      return insolvencyKeysAreValid(request.resource.data) && validInsolvency(request.resource.data, partnerId) && responsibilityUnchanged(resource.data, request.resource.data)
        && request.resource.data.partnerId == resource.data.partnerId && request.resource.data.partnerName == resource.data.partnerName
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedByName == profileName(ownProfile());
    }
    function insolvencyStatusUpdate(partnerId) {
      return edit('insolvencies')
        && resource.data.get('mergedIntoPartnerId', null) == null && resource.data.get('status', '') != 'merged'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.status == 'insolvency' && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedByName == profileName(ownProfile())
        && existsAfter(/databases/$(database)/documents/insolvencies/$(partnerId))
        && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.partnerId == partnerId;
    }
    match /insolvencies/{partnerId} {
      allow read: if view('insolvencies');
      allow create: if edit('insolvencies') && createdInsolvency(partnerId);
      allow update: if edit('insolvencies') && updatedInsolvency(partnerId);
      allow delete: if edit('insolvencies');

      match /movements/{movementId} {
        // Legacy general movements are intentionally retired. Insolvency
        // finance is now represented only by claims and quota payments.
        allow read, write: if false;
      }

      match /updates/{updateId} {
        function validInsolvencyUpdate(data) {
          return data.keys().hasAll(['type', 'text', 'createdByUserId', 'createdByName', 'createdAt'])
            && data.keys().hasOnly(['type', 'text', 'createdByUserId', 'createdByName', 'createdAt'])
            && data.type == 'system' && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
            && data.createdByUserId == request.auth.uid && data.createdByName == profileName(ownProfile()) && data.createdAt == request.time;
        }
        allow read: if view('insolvencies');
        allow create: if edit('insolvencies') && validInsolvencyUpdate(request.resource.data)
          && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.partnerId == partnerId
          && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.updatedBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /claims/{claimId} {
        function validInsolvencyClaim(data) {
          return data.keys().hasAll(['invoiceNumber', 'netAmount', 'vatAmount', 'grossAmount', 'filedInInsolvencyTable', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'])
            && data.keys().hasOnly(['invoiceNumber', 'netAmount', 'vatAmount', 'grossAmount', 'filedInInsolvencyTable', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'])
            && data.invoiceNumber is string && data.invoiceNumber.size() > 0 && data.invoiceNumber.size() <= 240
            && data.netAmount is number && data.netAmount >= 0 && data.vatAmount is number && data.vatAmount >= 0
            && data.grossAmount is number && data.grossAmount == data.netAmount + data.vatAmount && data.filedInInsolvencyTable is bool
            && data.createdBy is string && data.createdByName is string && data.updatedBy is string && data.updatedByName is string;
        }
        function claimParentWasUpdated() {
          return getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.partnerId == partnerId
            && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.updatedBy == request.auth.uid;
        }
        allow read: if view('insolvencies');
        allow create: if edit('insolvencies') && validInsolvencyClaim(request.resource.data) && claimParentWasUpdated()
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdByName == profileName(ownProfile())
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedByName == profileName(ownProfile());
        allow update: if edit('insolvencies') && validInsolvencyClaim(request.resource.data) && claimParentWasUpdated()
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedByName == profileName(ownProfile());
        allow delete: if edit('insolvencies') && claimParentWasUpdated();
      }

      match /quotaPayments/{paymentId} {
        function validInsolvencyQuotaPayment(data) {
          return data.keys().hasAll(['paymentDate', 'netAmount', 'vatAmount', 'grossAmount', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'])
            && data.keys().hasOnly(['paymentDate', 'netAmount', 'vatAmount', 'grossAmount', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'])
            && data.paymentDate is string && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.netAmount is number && data.netAmount >= 0 && data.vatAmount is number && data.vatAmount >= 0
            && data.grossAmount is number && data.grossAmount == data.netAmount + data.vatAmount
            && data.createdBy is string && data.createdByName is string && data.updatedBy is string && data.updatedByName is string;
        }
        function quotaPaymentParentWasUpdated() {
          return getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.partnerId == partnerId
            && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.updatedBy == request.auth.uid;
        }
        allow read: if view('insolvencies');
        allow create: if edit('insolvencies') && validInsolvencyQuotaPayment(request.resource.data) && quotaPaymentParentWasUpdated()
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdByName == profileName(ownProfile())
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedByName == profileName(ownProfile());
        allow update: if edit('insolvencies') && validInsolvencyQuotaPayment(request.resource.data) && quotaPaymentParentWasUpdated()
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedByName == profileName(ownProfile());
        allow delete: if edit('insolvencies') && quotaPaymentParentWasUpdated();
      }

      match /deadlines/{deadlineId} {
        function validInsolvencyDeadline(data) {
          return data.keys().hasAll(['date', 'reminderEnabled', 'note', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'])
            && data.keys().hasOnly(['date', 'time', 'reminderEnabled', 'reminderRecipientEmail', 'reminderOccurrence', 'note', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'])
            && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && (!data.keys().hasAll(['time']) || data.time == null || (data.time is string && data.time.matches('^[0-9]{2}:[0-9]{2}$')))
            && data.reminderEnabled is bool && (!data.keys().hasAll(['reminderRecipientEmail']) || data.reminderRecipientEmail == null || (data.reminderRecipientEmail is string && data.reminderRecipientEmail.size() <= 320)) && (data.note == null || (data.note is string && data.note.size() <= 4000))
            && data.createdBy is string && data.createdByName is string && data.updatedBy is string && data.updatedByName is string && validDeadlineReminderFields(data);
        }
        function deadlineParentWasUpdated() {
          return getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.partnerId == partnerId
            && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.updatedBy == request.auth.uid;
        }
        allow read: if view('insolvencies');
        allow create: if edit('insolvencies') && validInsolvencyDeadline(request.resource.data) && deadlineParentWasUpdated()
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdByName == profileName(ownProfile())
          && validNewDeadlineReminder(request.resource.data)
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedByName == profileName(ownProfile());
        allow update: if edit('insolvencies') && validInsolvencyDeadline(request.resource.data) && deadlineParentWasUpdated()
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedByName == profileName(ownProfile())
          && validChangedDeadlineReminder(resource.data, request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'time', 'reminderEnabled', 'reminderOccurrence', 'note', 'updatedAt', 'updatedBy', 'updatedByName']);
        allow delete: if edit('insolvencies') && deadlineParentWasUpdated();
      }

      match /documents/{documentId} {
        function validInsolvencyDocument(data) {
          return data.keys().hasAll(['id', 'title', 'description', 'pageCount', 'fileName', 'storagePath', 'contentType', 'fileSize', 'uploadedByUserId', 'uploadedByName', 'createdAt', 'updatedAt'])
            && data.keys().hasOnly(['id', 'title', 'description', 'pageCount', 'fileName', 'storagePath', 'contentType', 'fileSize', 'uploadedByUserId', 'uploadedByName', 'createdAt', 'updatedAt'])
            && data.id == documentId && data.title is string && data.title.size() > 0 && data.title.size() <= 500
            && data.description is string && data.description.size() <= 4000 && (data.pageCount == null || (data.pageCount is int && data.pageCount > 0 && data.pageCount <= 10000))
            && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 240
            && data.storagePath == 'insolvencies/' + partnerId + '/documents/' + documentId + '.pdf' && data.contentType == 'application/pdf'
            && data.fileSize is number && data.fileSize > 0 && data.fileSize <= 20 * 1024 * 1024 && data.uploadedByUserId is string && data.uploadedByName is string;
        }
        allow read: if view('insolvencies');
        allow create: if edit('insolvencies') && validInsolvencyDocument(request.resource.data)
          && getAfter(/databases/$(database)/documents/insolvencies/$(partnerId)).data.partnerId == partnerId
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.uploadedByUserId == request.auth.uid && request.resource.data.uploadedByName == profileName(ownProfile());
        allow update: if edit('insolvencies') && validInsolvencyDocument(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time
          && request.resource.data.uploadedByUserId == resource.data.uploadedByUserId && request.resource.data.uploadedByName == resource.data.uploadedByName
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'updatedAt']);
        allow delete: if edit('insolvencies');
      }
    }

    // Source and summaries are committed atomically by savePalletRecord.
    match /palletMovements/{id} { allow read: if view('pallets'); allow write: if false; }
    match /palletClosings/{id} { allow read: if view('pallets'); allow write: if false; }
    match /newsItems/{id} {
      allow read: if view('news');
      allow create, update, delete: if edit('news');
      // Research updates are written only by the Admin SDK. They remain
      // readable with the parent news item but cannot be changed by clients.
      match /updates/{updateId} {
        allow read: if view('news');
        allow write: if false;
      }
    }
    match /newsCategoryReadStates/{userId} {
      allow read, write: if false;
      match /categories/{categoryId} {
        function validNewsCategoryReadState() {
          return categoryId in ['internal', 'traffic_infrastructure', 'law_regulations', 'logistics_market']
            && request.resource.data.keys().hasAll(['category', 'seenAt'])
            && request.resource.data.keys().hasOnly(['category', 'seenAt'])
            && request.resource.data.category == categoryId
            && request.resource.data.seenAt == request.time;
        }
        allow read: if active() && userId == request.auth.uid;
        allow create, update: if active() && userId == request.auth.uid && validNewsCategoryReadState();
        allow delete: if false;
      }
    }
    match /newsItemReadStates/{userId} {
      allow read, write: if false;
      match /items/{itemId} {
        function validNewsItemPersonalState() {
          return exists(/databases/$(database)/documents/newsItems/$(itemId))
            && request.resource.data.keys().hasAll(['itemId'])
            && request.resource.data.keys().hasOnly(['itemId', 'readAt', 'later', 'favorite', 'reaction', 'reactionUpdatedAt'])
            && request.resource.data.itemId == itemId
            && (!request.resource.data.keys().hasAny(['readAt']) || request.resource.data.readAt is timestamp)
            && (!request.resource.data.keys().hasAny(['later']) || request.resource.data.later is bool)
            && (!request.resource.data.keys().hasAny(['favorite']) || request.resource.data.favorite is bool);
        }
        allow read: if view('news') && userId == request.auth.uid;
        // Reactions are only written by the callable function. Client-side
        // personal-state updates may preserve them but cannot add or alter them.
        allow create: if view('news') && userId == request.auth.uid && validNewsItemPersonalState()
          && !request.resource.data.keys().hasAny(['reaction', 'reactionUpdatedAt']);
        allow update: if view('news') && userId == request.auth.uid && validNewsItemPersonalState()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reaction', 'reactionUpdatedAt']);
        allow delete: if false;
      }
    }
    function isGeneralInternalDocument(data) {
      return data.documentScope == 'general' && !data.keys().hasAny(['damageCaseId', 'damageCaseNumber']);
    }
    match /internalDocuments/{id} {
      allow read: if view('documents') && resource.data.documentScope == 'general';
      allow create, update: if edit('documents') && isGeneralInternalDocument(request.resource.data);
      allow delete: if edit('documents');
    }
    function damageCaseKeysAreValid(data) {
      return data.keys().hasAll(['caseNumber', 'caseYear', 'caseSequence', 'status', 'damageDate', 'title', 'description', 'transportReference', 'claimant', 'contractor', 'responsibleUserId', 'responsibleUserName', 'damageAmount', 'openBplRisk', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'])
        && data.keys().hasOnly(['caseNumber', 'caseYear', 'caseSequence', 'status', 'damageDate', 'title', 'description', 'damageType', 'transportReference', 'damageLocation', 'claimant', 'claimantPartnerId', 'contractor', 'contractorPartnerId', 'responsibleUserId', 'responsibleUserName', 'dueDate', 'damageAmount', 'legalBasis', 'cargoWeightKg', 'liabilityLimit', 'insuranceRelevance', 'bplInsuranceCaseNumber', 'contractorInsurance', 'contractorInsuranceCaseNumber', 'customerInsurance', 'customerInsuranceNumber', 'contractorLiability', 'liabilityNote', 'openBplRisk', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName']);
    }
    function validDamageText(value, limit) { return value == null || (value is string && value.size() <= limit); }
    function validDamageType(data) {
      return !data.keys().hasAny(['damageType']) || data.damageType == null || (data.damageType is string && data.damageType.size() > 0 && data.damageType.size() <= 120);
    }
    function validDamageResponsible(data) {
      return (data.responsibleUserId == null && data.responsibleUserName == null)
        || (data.responsibleUserId is string && data.responsibleUserName is string);
    }
    function damageRecipientMatches(userId, name) {
      let profile = get(/databases/$(database)/documents/users/$(userId)).data;
      return profile.active == true
        && (profile.role == 'superadmin' || profile.get('permissions', {}).get('damages', 'none') in ['view', 'edit'])
        && name == profileName(profile);
    }
    function validDamageReminderResponsible(data) {
      return (data.responsibleUserId == null && data.responsibleUserName == null)
        || (data.responsibleUserId is string && data.responsibleUserName is string
          && damageRecipientMatches(data.responsibleUserId, data.responsibleUserName));
    }
    function hasPartnerReferenceRole(partner, role) {
      return (role == 'customer' && partner.keys().hasAll(['debtorNumber']) && partner.debtorNumber is string && partner.debtorNumber.size() > 0)
        || (role == 'carrier' && partner.keys().hasAll(['creditorNumber']) && partner.creditorNumber is string && partner.creditorNumber.size() > 0)
        || (partner.keys().hasAll(['dycosReferences']) && partner.dycosReferences is map
          && ((role == 'customer' && partner.dycosReferences.keys().hasAll(['debtorNumbers']) && partner.dycosReferences.debtorNumbers is list && partner.dycosReferences.debtorNumbers.size() > 0)
            || (role == 'carrier' && partner.dycosReferences.keys().hasAll(['creditorNumbers']) && partner.dycosReferences.creditorNumbers is list && partner.dycosReferences.creditorNumbers.size() > 0)));
    }
    function roleMapContains(roleMap, role) {
      return roleMap is map && ((role == 'customer' && ((roleMap.keys().hasAll(['customer']) && roleMap.customer == true) || (roleMap.keys().hasAll(['kunde']) && roleMap.kunde == true)))
        || (role == 'carrier' && ((roleMap.keys().hasAll(['carrier']) && roleMap.carrier == true) || (roleMap.keys().hasAll(['unternehmer']) && roleMap.unternehmer == true))));
    }
    function hasExplicitPartnerRole(partner, role) {
      return (partner.keys().hasAll(['businessPartnerRoles']) && ((partner.businessPartnerRoles is list && partner.businessPartnerRoles.hasAny([role, role == 'customer' ? 'kunde' : 'unternehmer'])) || (partner.businessPartnerRoles is string && partner.businessPartnerRoles in [role, role == 'customer' ? 'kunde' : 'unternehmer']) || roleMapContains(partner.businessPartnerRoles, role)))
        || (partner.keys().hasAll(['partnerRoles']) && ((partner.partnerRoles is list && partner.partnerRoles.hasAny([role, role == 'customer' ? 'kunde' : 'unternehmer'])) || (partner.partnerRoles is string && partner.partnerRoles in [role, role == 'customer' ? 'kunde' : 'unternehmer']) || roleMapContains(partner.partnerRoles, role)));
    }
    function hasProvisionalTransportCarrierRole(partner) {
      let status = partner.get('taImportStatus', null);
      return status is map && status.get('source', null) == 'dycosTransportOrder'
        && status.get('missingRequiredFields', null) is list
        && 'creditorNumber' in status.missingRequiredFields;
    }
    function hasBusinessPartnerRole(partner, role) {
      return hasPartnerReferenceRole(partner, role) || hasExplicitPartnerRole(partner, role)
        || (role == 'carrier' && hasProvisionalTransportCarrierRole(partner));
    }
    function damagePartnerMatches(partnerId, name, role) {
      let partner = get(/databases/$(database)/documents/businessPartners/$(partnerId)).data;
      return name == partner.companyName
        && ((role == 'carrier' && 'taImportStatus' in partner && hasProvisionalTransportCarrierRole(partner))
          || legalDisputePartnerHasRole(partner, role));
    }
    function validDamageClaimant(data) {
      return !data.keys().hasAny(['claimantPartnerId']) || data.claimantPartnerId == null
        || (data.claimantPartnerId is string && damagePartnerMatches(data.claimantPartnerId, data.claimant, 'customer'));
    }
    function validDamageContractor(data) {
      return !data.keys().hasAny(['contractorPartnerId']) || data.contractorPartnerId == null
        || (data.contractorPartnerId is string && damagePartnerMatches(data.contractorPartnerId, data.contractor, 'carrier'));
    }
    function validDamageAmount(value) { return value == null || (value is number && value >= 0); }
    function validDamageDate(value) { return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function validDamageSelection(value, options) { return value == null || value in options; }
    function damageInsuranceFieldsValid(data) {
      // The create form leaves these later-edit sections empty. Prove their
      // shared null defaults together, then validate every populated field.
      return data.diff({'legalBasis': null, 'cargoWeightKg': null, 'liabilityLimit': null, 'insuranceRelevance': null, 'bplInsuranceCaseNumber': null, 'contractorInsurance': null, 'contractorInsuranceCaseNumber': null, 'customerInsurance': null, 'customerInsuranceNumber': null, 'contractorLiability': null, 'liabilityNote': null}).changedKeys().size() == 0
        || (validDamageSelection(data.get('legalBasis', null), ['cmr', 'national', 'goodwill', 'other'])
        && validDamageAmount(data.get('cargoWeightKg', null))
        && validDamageAmount(data.get('liabilityLimit', null))
        && validDamageSelection(data.get('insuranceRelevance', null), ['yes', 'no', 'pending'])
        && validDamageText(data.get('bplInsuranceCaseNumber', null), 240)
        && validDamageText(data.get('contractorInsurance', null), 240)
        && validDamageText(data.get('contractorInsuranceCaseNumber', null), 240)
        && validDamageText(data.get('customerInsurance', null), 240)
        && validDamageText(data.get('customerInsuranceNumber', null), 240)
        && validDamageSelection(data.get('contractorLiability', null), ['open', 'acknowledged', 'rejected', 'partially_acknowledged'])
        && validDamageText(data.get('liabilityNote', null), 4000));
    }
    function validDamageCaseContent(data) {
      return data.caseNumber is string && data.caseNumber.matches('^S-[0-9]{4}-[0-9]{4}$')
        && data.caseYear is string && data.caseYear.matches('^[0-9]{4}$')
        && data.caseSequence is int && data.caseSequence >= 1 && data.caseSequence <= 9999
