        && request.resource.data.status == 'withdrawn' && request.resource.data.assignedUserId == null && request.resource.data.assignedUserName == null && request.resource.data.assignedAt == null
        && request.resource.data.withdrawnAt == request.time && request.resource.data.withdrawnByUserId == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt', 'withdrawnByUserId', 'assignedUserId', 'assignedUserName', 'assignedAt', 'updatedAt']);
    }
    function isNoteTimestampTouch() {
      return request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
    }
    function todoDocument(todoId) { return get(/databases/$(database)/documents/todos/$(todoId)).data; }
    function todoAfter(todoId) { return getAfter(/databases/$(database)/documents/todos/$(todoId)).data; }
    function validTodoUpdate(data, parent) {
      return data.keys().hasAll(['text', 'type', 'createdByUserId', 'createdByName', 'createdAt'])
        && data.keys().hasOnly(['text', 'type', 'createdByUserId', 'createdByName', 'createdAt'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.type in ['note', 'system'] && data.createdByUserId == request.auth.uid
        && ((data.type == 'system' && parent.createdAt == request.time && parent.creatorUserId == request.auth.uid)
          ? data.createdByName == parent.creatorName : todoProfileNameMatches(data.createdByName, ownProfile()))
        && data.createdAt == request.time;
    }
    function canCreateTodoUpdate(todoId) {
      let parent = todoAfter(todoId);
      let data = request.resource.data;
      // The new parent is validated in this same atomic write, including its
      // active-editor gate. An existing task retains the normal history ACL.
      return ((data.type == 'system' && parent.createdAt == request.time && parent.creatorUserId == request.auth.uid
          && !exists(/databases/$(database)/documents/todos/$(todoId))) ? true
        : (((data.type == 'note' && todoAccess('view')) || (data.type == 'system' && todoAccess('edit')))
          && canReadTodo(parent))) && validTodoUpdate(data, parent);
    }
    function validTodoDeadline(data) {
      return data.keys().hasAll(['type', 'date', 'reminderEnabled', 'note', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'])
        && data.keys().hasOnly(['type', 'date', 'time', 'reminderEnabled', 'reminderRecipientEmail', 'reminderOccurrence', 'reminderRecipientMode', 'reminderRecipientUserIds', 'note', 'calendarEntryId', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'])
        && data.type in ['deadline', 'appointment'] && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!data.keys().hasAny(['time']) || data.time == null || (data.time is string && data.time.matches('^[0-9]{2}:[0-9]{2}$')))
        && data.reminderEnabled is bool && (!data.keys().hasAny(['reminderRecipientEmail']) || data.reminderRecipientEmail == null || (data.reminderRecipientEmail is string && data.reminderRecipientEmail.size() <= 320))
        && (data.note == null || (data.note is string && data.note.size() <= 4000))
        && (data.get('calendarEntryId', null) == null || (data.calendarEntryId is string && data.calendarEntryId.size() > 0)) && validTodoReminderRecipients(data)
        && data.createdBy is string && data.createdByName is string && data.updatedBy is string && data.updatedByName is string && validDeadlineReminderFields(data);
    }
    function todoDeadlineEditor(todoId) {
      let parent = todoDocument(todoId);
      return todoAccess('edit') && isTodoCollaborator(parent) && parent.status in ['open', 'in_progress'];
    }
    function todoDeadlineParentWasUpdated(todoId) { return todoAfter(todoId).updatedAt == request.time; }
    function validNewTodoReminder(data) { return validNewDeadlineReminder(data); }
    match /todos/{id} {
      allow read: if view('todos') && canReadTodo(resource.data);
      allow create: if resource == null ? isCreatedTodo() : false;
      allow update: if resource == null ? false : ((todoAccess('edit') && todoKeysAreValid(request.resource.data) && (isCompletion() || isReactivation() || isCreatorContentEdit() || isCreatorResetAssignment() || isWithdrawal()))
        || (todoAccess('view') && canReadTodo(resource.data) && todoKeysAreValid(request.resource.data) && isNoteTimestampTouch()));
      allow delete: if false;

      match /updates/{updateId} {
        allow read: if view('todos') && canReadTodo(todoDocument(id));
        // A system entry already requires edit (which includes view). Notes
        // retain their existing view-only capability; neither branch bypasses
        // the parent task's audience/ownership or the payload validation.
        allow create: if canCreateTodoUpdate(id);
        allow update, delete: if false;
      }

      match /deadlines/{deadlineId} {
        allow read: if view('todos') && canReadTodo(todoDocument(id));
        allow create: if todoDeadlineEditor(id) && todoDeadlineParentWasUpdated(id) && validTodoDeadline(request.resource.data)
          && validNewTodoReminder(request.resource.data) && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdByName == profileName(ownProfile())
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedByName == profileName(ownProfile());
        allow update: if todoDeadlineEditor(id) && todoDeadlineParentWasUpdated(id) && validTodoDeadline(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedByName == profileName(ownProfile())
          && validChangedDeadlineReminder(resource.data, request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'date', 'time', 'reminderEnabled', 'reminderOccurrence', 'reminderRecipientMode', 'reminderRecipientUserIds', 'note', 'updatedAt', 'updatedBy', 'updatedByName']);
        allow delete: if todoDeadlineEditor(id) && todoDeadlineParentWasUpdated(id);
      }
    }
    // Obsolete owner-only mirrors must never expose stale group task data.
    match /todoCalendarEntries/{entryId} { allow read, write: if false; }
    match /contractCostCategories/{id} {
      allow read: if view('contracts');
      allow write: if false;
      match /history/{entryId} {
        allow read: if view('contracts');
        allow write: if false;
      }
      match /mutations/{mutationId} { allow read, write: if false; }
    }
    match /contractCostCategoryNames/{nameKey} { allow read, write: if false; }
    match /contracts/{id} {
      allow read: if view('contracts');
      allow create: if edit('contracts')
        && request.resource.data.keys().hasAll(['partnerName', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['partnerName', 'createdBy', 'createdAt'])
        && request.resource.data.partnerName is string
        && request.resource.data.partnerName.size() > 0
        && request.resource.data.partnerName.size() <= 240
        && request.resource.data.partnerName == request.resource.data.partnerName.trim()
        && request.resource.data.partnerName.matches('.*\\S.*')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      // Root editing and all file contents are managed by mutateContract.
      allow update, delete: if false;
      match /{collection}/{recordId} {
        allow read: if collection in ['positions', 'deadlines', 'notes', 'history', 'documents']
          && view('contracts')
          && exists(/databases/$(database)/documents/contracts/$(id));
        allow write: if false;
      }
    }
    function ownVacationRequest(data, requestId) {
      let base = ['id', 'userId', 'type', 'startDate', 'endDate', 'days', 'halfDayDate', 'vacationType', 'requestComment', 'note', 'status', 'createdAt', 'updatedAt'];
      let followUp = base.concat(['requestStatus', 'vacationId', 'originalRequestId']);
      return data.userId == request.auth.uid && data.type == 'vacation'
        && data.id == requestId && data.createdAt == request.time && data.updatedAt == request.time
        && ((data.status == 'pending' && data.keys().hasOnly(base.concat(['mainStatus'])) && data.get('mainStatus', 'pending') == 'pending')
          || (data.originalRequestId is string && data.vacationId == data.originalRequestId
          && data.get('requestStatus', 'pending') == 'pending'
          && ((data.status == 'change_requested' && data.keys().hasOnly(followUp.concat(['changeRequest'])) && data.changeRequest is map)
            || (data.status == 'cancellation_requested' && data.keys().hasOnly(followUp.concat(['requestKind', 'cancellationRequest']))
              && data.get('requestKind', 'cancellation') == 'cancellation' && data.cancellationRequest is map))
          && ownApprovedVacation(data.originalRequestId)));
    }
    function ownApprovedVacation(id) {
      let original = get(/databases/$(database)/documents/vacationRequests/$(id)).data;
      return original.userId == request.auth.uid && original.status == 'approved'
        && !original.keys().hasAny(['originalRequestId', 'vacationId', 'changeRequest', 'cancellationRequest', 'requestKind']);
    }
    match /vacationRequests/{id} {
      allow read: if view('vacation') && (resource.data.userId == request.auth.uid || resource.data.status == 'approved');
      allow create: if edit('vacation') && ownVacationRequest(request.resource.data, id);
      // Approval, rejection and all other changes are handled by the callable
      // function, which validates the manager's department server-side.
      allow update, delete: if false;
    }
    // Payroll processing and internal HR notes are strictly separate from
    // vacation workflow documents and are exposed only through HR callables.
    match /hrVacationMeta/{vacationId} {
      allow read, write: if false;
    }
    // Manual vacation adjustments are private HR data and may only be read
    // and written through the Personalverwaltung callables.
    match /hrVacationAdjustments/{adjustmentId} {
      allow read, write: if false;
    }
    match /vacationHistory/{id} {
      allow read: if view('vacation') && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /calendarHolidays/{id} { allow read: if view('vacation'); allow write: if superadmin(); }
    // Mail action jobs/results are private server-managed records. The callables
    // recheck ownership and module permissions, including for superadmins.
    // Only an owned, connected mailbox may subscribe to this content-free
    // revision signal. All recommendations and subscription credentials remain
    // server-only and are fetched through the ownership-checked callable.
    match /mailboxRecommendationSignals/{connectionId} {
      function connectedMailbox() {
        let connection = get(/databases/$(database)/documents/mailboxConnections/$(connectionId)).data;
        return connection.ownerId == request.auth.uid && connection.status == 'connected'
          && (connection.kind != 'shared' || (
            get(/databases/$(database)/documents/mailboxConnections/$(connection.parentConnectionId)).data.ownerId == request.auth.uid
            && get(/databases/$(database)/documents/mailboxConnections/$(connection.parentConnectionId)).data.status == 'connected'));
      }
      allow get: if view('mailboxes') && connectedMailbox();
      allow list, write: if false;
    }
    // Triage feedback contains bounded mail evidence; access only via checked callables.
    match /mailboxTriageFeedback/{id} { allow read, write: if false; }
    match /mailboxTriageFeedbackStates/{id} { allow read, write: if false; }
    match /mailboxActionRuns/{id} { allow read, write: if false; }
    match /mailboxActionScopes/{scope}/{document=**} { allow read, write: if false; }
    match /vacationBlocks/{id} { allow read: if view('vacation'); allow write: if superadmin(); }
    // Time calculations, work models and append-only audit records are exposed
    // only through callables that enforce personal / department scopes.
    match /timeWorkModels/{id} { allow read, write: if false; }
    match /timeAccounts/{id} { allow read, write: if false; }
    match /timeDays/{id} { allow read, write: if false; }
    match /timeHistory/{id} { allow read, write: if false; }
    match /timeWorkModelTemplates/{document=**} { allow read, write: if false; }
    match /timeWorkModelTemplateNames/{id} { allow read, write: if false; }
  }
}
